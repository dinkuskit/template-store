#!/usr/bin/env node

/**
 * Read-only public URL contract verifier.
 *
 * Product URL, Product JSON-LD, and public feed checks are required.
 * An origin with no product URL does not fail only because those pages are absent.
 */
import { readFileSync } from "node:fs";
import { registerHooks } from "node:module";
import process from "node:process";
import { parse as parseCsv } from "csv-parse/sync";
import { decodeHTMLAttribute } from "entities";
import sax from "sax";

registerHooks({
  resolve(specifier, context, nextResolve) {
    if (specifier.endsWith(".js") && context.parentURL?.startsWith("file:")) {
      try {
        return nextResolve(specifier, context);
      } catch {
        return nextResolve(specifier.replace(/\.js$/u, ".ts"), context);
      }
    }
    return nextResolve(specifier, context);
  },
});

const { DEMO_PRODUCTS } = await import("../scripts/demo-seed-policy.ts");
const { demoPlaceholderImage, demoProductKind } = await import("../src/features/playground/demo-products.ts");
const { buildMerchCollections } = await import("../src/features/store-shell/merch-catalog.ts");

const REQUIRED_LANDED_CHECKS = true;
const originArg = process.argv[2];
const demoHost = process.argv.includes("--demo-host");
const timeoutMs = Number(process.env.VERIFY_SITE_TIMEOUT_MS ?? 15_000);

if (!originArg || originArg.startsWith("-")) {
  console.error("usage: bin/verify-site <origin> [--demo-host]");
  process.exit(2);
}

const origin = new URL(originArg);
origin.pathname = "/";
origin.search = "";
origin.hash = "";
const base = origin.origin;
const LOOPBACK_HOSTS = new Set(["127.0.0.1", "localhost", "::1"]);
const results = [];
const visited = new Set();
const discovered = new Set(["/"]);
const sitemapPaths = new Set();
const pages = new Map();
const fetchedResponses = new Map();

function deriveProductImagePaths() {
  const paths = new Set();
  const seed = JSON.parse(readFileSync(new URL("../seed/seed.json", import.meta.url), "utf8"));
  const collections = buildMerchCollections(seed.content?.products ?? [], seed.content?.categories ?? []);
  for (const collection of collections) {
    for (const item of collection.items) {
      paths.add(`/merch/${item.illustration}.svg`);
    }
  }
  for (const product of DEMO_PRODUCTS) {
    const src = demoPlaceholderImage(product.sku, `demo-${demoProductKind(product)}`);
    if (src) paths.add(src);
  }
  return paths;
}

const productImagePaths = deriveProductImagePaths();

function result(name, status, detail) {
  results.push({ name, status, detail });
  const marker = status === "PASS" ? "✓" : status === "SKIP" ? "–" : "✗";
  console.log(`${marker} ${status} ${name}${detail ? ` — ${detail}` : ""}`);
  if (status === "FAIL") {
    const text = `${name}${detail ? ` — ${detail}` : ""}`;
    console.error(`::error title=verify-site::${text.replace(/\n/g, "%0A")}`);
  }
}

function requiredOrSkip(name, detail, passed = false) {
  if (REQUIRED_LANDED_CHECKS) {
    result(name, passed ? "PASS" : "FAIL", passed ? undefined : detail);
  } else {
    result(name, "SKIP", `${detail} Set REQUIRED_LANDED_CHECKS=true when landed.`);
  }
}

function absoluteUrl(path) {
  return new URL(path, `${base}/`);
}

function checkPathShape(url, source) {
  if (/%2f/i.test(url.pathname)) {
    result("URL encoding", "FAIL", `${source} contains %2F: ${url.href}`);
  }
  if (url.pathname !== "/" && url.pathname.endsWith("/")) {
    result("Trailing slash", "FAIL", `${source} is not slashless: ${url.href}`);
  }
}

async function request(url, method = "GET") {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs);
  try {
    return await fetch(url, {
      method,
      redirect: "manual",
      signal: controller.signal,
      headers: {
        "user-agent": "dinkuskit-verify-site/1.0",
        ...(LOOPBACK_HOSTS.has(origin.hostname) ? { "cf-connecting-ip": "127.0.0.1" } : {}),
      },
    });
  } finally {
    clearTimeout(timer);
  }
}

function redirectTarget(response, url) {
  const location = response.headers.get("location");
  if (!location) {
    result("Redirect contract", "FAIL", `${url.href} has no Location header`);
    return null;
  }
  const target = new URL(location, url);
  checkPathShape(target, `redirect target from ${url.pathname}`);
  const cacheControl = response.headers.get("cache-control")?.toLowerCase() ?? "";
  const maxAge = Number(cacheControl.match(/max-age\s*=\s*(\d+)/)?.[1] ?? 0);
  if (cacheControl.includes("immutable") || maxAge > 86_400) {
    result("Redirect cache policy", "FAIL", `${url.pathname} has unsafe Cache-Control: ${cacheControl}`);
  }
  if (target.origin !== base) {
    result("Redirect target", "FAIL", `${url.pathname} leaves the public origin`);
  }
  return target;
}

function parseLinks(html, pageUrl) {
  for (const match of html.matchAll(/\b(?:href|src)\s*=\s*["']([^"']+)["']/gi)) {
    const raw = match[1];
    if (/^(?:#|mailto:|tel:|javascript:|data:)/i.test(raw)) continue;
    let link;
    try {
      link = new URL(raw, pageUrl);
    } catch {
      result("Internal links", "FAIL", `Invalid URL on ${pageUrl.pathname}: ${raw}`);
      continue;
    }
    if (link.origin !== base) continue;
    link.hash = "";
    checkPathShape(link, `link on ${pageUrl.pathname}`);
    discovered.add(link.pathname + link.search);
  }
  for (const match of html.matchAll(/<img\b[^>]*\bsrc\s*=\s*["']([^"']+)["'][^>]*>/gi)) {
    const raw = match[1];
    if (/^(?:data:)/i.test(raw)) continue;
    try {
      const imgUrl = new URL(raw, pageUrl);
      if (imgUrl.origin === base) {
        imgUrl.hash = "";
        productImagePaths.add(imgUrl.pathname + imgUrl.search);
      }
    } catch {
      // Malformed URLs are already reported by the general href/src loop above.
    }
  }
}

function parseCanonical(html, pageUrl) {
  const matches = [...html.matchAll(/<link\b[^>]*\brel\s*=\s*["'][^"']*\bcanonical\b[^"']*["'][^>]*>/gi)];
  const values = matches.map((match) => match[0].match(/\bhref\s*=\s*["']([^"']+)["']/i)?.[1]).filter(Boolean);
  if (values.length !== 1) return values;
  try {
    return [new URL(values[0], pageUrl).href];
  } catch {
    return values;
  }
}

function parseJsonLd(html, pageUrl) {
  const nodes = [];
  for (const match of html.matchAll(/<script\b[^>]*type\s*=\s*["']application\/ld\+json["'][^>]*>([\s\S]*?)<\/script>/gi)) {
    try {
      nodes.push(JSON.parse(match[1].trim()));
    } catch {
      result("JSON-LD syntax", "FAIL", `${pageUrl.pathname} contains invalid JSON-LD`);
    }
  }
  return nodes;
}

function sitemapLocations(xml) {
  return [...xml.matchAll(/<loc>\s*([^<\s]+)\s*<\/loc>/gi)].map((match) => match[1]);
}

function onVerifierOrigin(url) {
  if (url.origin === base) return true;
  const expected = new URL(base);
  return (
    LOOPBACK_HOSTS.has(url.hostname) &&
    LOOPBACK_HOSTS.has(expected.hostname) &&
    url.protocol === expected.protocol &&
    url.port === expected.port
  );
}

function ontoVerifierOrigin(url) {
  const expected = new URL(base);
  const next = new URL(url.href);
  next.protocol = expected.protocol;
  next.hostname = expected.hostname;
  next.port = expected.port;
  return next;
}

function addSitemapPage(raw) {
  try {
    const parsed = new URL(raw);
    if (!onVerifierOrigin(parsed)) {
      result("Sitemap origin", "FAIL", `${parsed.href} is outside ${base}`);
      return;
    }
    const url = ontoVerifierOrigin(parsed);
    url.hash = "";
    checkPathShape(url, "sitemap");
    sitemapPaths.add(url.pathname + url.search);
    discovered.add(url.pathname + url.search);
  } catch {
    result("Sitemap XML", "FAIL", `Invalid sitemap URL: ${raw}`);
  }
}

async function inspect(path, from = "crawl") {
  const url = absoluteUrl(path);
  checkPathShape(url, from);
  if (url.origin !== base || visited.has(url.href)) return null;
  visited.add(url.href);
  let response;
  try {
    response = await request(url);
  } catch (error) {
    result("HTTP availability", "FAIL", `${url.pathname}: ${error.message}`);
    return null;
  }
  const type = response.headers.get("content-type") ?? "";
  fetchedResponses.set(url.pathname + url.search, { status: response.status, contentType: type });
  if (response.status >= 300 && response.status < 400) {
    const listed = sitemapPaths.has(url.pathname + url.search);
    if (listed) {
      result(
        "Sitemap redirect",
        "FAIL",
        `${url.pathname} is listed in the sitemap but returned ${response.status}`,
      );
      return response;
    }
    const target = redirectTarget(response, url);
    if (![301, 302].includes(response.status)) {
      result("Redirect status", "FAIL", `${url.pathname} returned ${response.status}; only 301/302 are allowed`);
    }
    if (target?.origin === base) await inspect(target.pathname + target.search, "redirect target");
    return response;
  }
  if (response.status < 200 || response.status >= 300) {
    if (sitemapPaths.has(url.pathname + url.search)) {
      result(
        "Sitemap availability",
        "FAIL",
        `${url.pathname} is listed in the sitemap but returned ${response.status}`,
      );
    } else if (!productImagePaths.has(url.pathname + url.search)) {
      result("HTTP availability", "FAIL", `${url.pathname} returned ${response.status}`);
    }
    return response;
  }
  const body = await response.text();
  if (type.includes("html")) {
    parseLinks(body, url);
    pages.set(url.pathname, {
      url,
      body,
      canonical: parseCanonical(body, url),
      jsonLd: parseJsonLd(body, url),
      noindex: /noindex/i.test(response.headers.get("x-robots-tag") ?? "") ||
        /<meta\b[^>]*(?:name=["']robots["'][^>]*content=["'][^"']*\bnoindex\b|content=["'][^"']*\bnoindex\b[^"']*["'][^>]*name=["']robots["'])/i.test(body),
    });
  }
  return response;
}

async function drainDiscovered() {
  const maxPages = 500;
  while (visited.size < maxPages) {
    const pending = [...discovered].filter((path) => !visited.has(absoluteUrl(path).href));
    if (pending.length === 0) return;
    for (const path of pending) await inspect(path);
  }
  result("Crawl coverage", "FAIL", `Stopped after ${maxPages} URLs; nested public links remain unvisited`);
}

async function verifyProductImages() {
  let imageFailures = 0;
  for (const imagePath of productImagePaths) {
    const url = absoluteUrl(imagePath);
    checkPathShape(url, "product image");
    let info = fetchedResponses.get(url.pathname + url.search);
    if (!info) {
      visited.add(url.href);
      try {
        const response = await request(url);
        info = {
          status: response.status,
          contentType: response.headers.get("content-type") ?? "",
        };
        fetchedResponses.set(url.pathname + url.search, info);
      } catch (error) {
        imageFailures += 1;
        result("Product images", "FAIL", `${imagePath}: ${error.message}`);
        continue;
      }
    }
    if (info.status !== 200) {
      imageFailures += 1;
      result(
        "Product images",
        "FAIL",
        `${imagePath} returned ${info.status} (Content-Type: ${info.contentType || "none"})`,
      );
      continue;
    }
    if (!/^image\//i.test(info.contentType)) {
      imageFailures += 1;
      result(
        "Product images",
        "FAIL",
        `${imagePath} returned non-image Content-Type: ${info.contentType || "none"}`,
      );
    }
  }
  if (imageFailures === 0) {
    result(
      "Product images",
      "PASS",
      `${productImagePaths.size} seeded/demo product image(s) served with image/* Content-Type`,
    );
  }
}

console.log(`verify-site: ${base}${demoHost ? " (demo-host policy)" : ""}`);
await inspect("/");
if (pages.get("/")?.body.includes("data-product-url-errors")) {
  result("Product URL duplicate claims", "FAIL", "Published product URL claims are ambiguous; inspect the server log and unpublish the duplicates.");
}
const homeRedirect = await request(new URL("/home", `${base}/`));
if (homeRedirect.status === 301 || homeRedirect.status === 302) {
  const target = redirectTarget(homeRedirect, new URL("/home", `${base}/`));
  if (target?.pathname !== "/") result("Homepage authority", "FAIL", "/home must redirect to /");
  else result("Homepage authority", "PASS", "/home redirects to /");
} else {
  result("Homepage authority", "FAIL", `/home returned ${homeRedirect.status}; it must redirect to /`);
}

let sitemapResponse;
try {
  sitemapResponse = await request(new URL("/sitemap.xml", `${base}/`));
} catch (error) {
  result("Sitemap availability", "FAIL", error.message);
}
if (sitemapResponse?.status === 404 && !REQUIRED_LANDED_CHECKS) {
  result("Sitemap contract", "SKIP", "Built-in sitemap is not available on this profile.");
} else if (sitemapResponse?.ok) {
  const xml = await sitemapResponse.text();
  const locations = sitemapLocations(xml);
  if (/<sitemapindex\b/i.test(xml)) {
    let childCount = 0;
    for (const rawChild of locations) {
      let childUrl;
      try {
        const parsed = new URL(rawChild);
        if (!onVerifierOrigin(parsed)) {
          result("Sitemap origin", "FAIL", `${parsed.href} is outside ${base}`);
          continue;
        }
        childUrl = ontoVerifierOrigin(parsed);
        checkPathShape(childUrl, "sitemap child");
      } catch {
        result("Sitemap XML", "FAIL", `Invalid child sitemap URL: ${rawChild}`);
        continue;
      }
      let childResponse;
      try {
        childResponse = await request(childUrl);
      } catch (error) {
        result("Sitemap child availability", "FAIL", `${childUrl.pathname}: ${error.message}`);
        continue;
      }
      if (!childResponse.ok) {
        result("Sitemap child availability", "FAIL", `${childUrl.pathname} returned ${childResponse.status}`);
        continue;
      }
      const childXml = await childResponse.text();
      if (/<sitemapindex\b/i.test(childXml)) {
        result("Sitemap XML", "FAIL", `${childUrl.pathname} must contain page URLs, not another sitemap index`);
        continue;
      }
      for (const rawPage of sitemapLocations(childXml)) {
        addSitemapPage(rawPage);
      }
      childCount += 1;
    }
    if (childCount === 0) {
      result("Sitemap contract", "SKIP", "Sitemap index has no usable same-origin child sitemaps on this test origin");
    } else {
      result("Sitemap availability", "PASS", `${childCount} child sitemap(s), ${sitemapPaths.size} page URL(s)`);
    }
  } else {
    for (const rawPage of locations) addSitemapPage(rawPage);
    if (sitemapPaths.size === 0) {
      result("Sitemap XML", "FAIL", "Sitemap has no <loc> URLs");
    } else {
      result("Sitemap availability", "PASS", `${sitemapPaths.size} URL(s)`);
    }
  }
} else if (sitemapResponse?.status === 500) {
  const sitemapError = await sitemapResponse.text();
  if (sitemapError.includes("<!-- EmDash not configured -->") && !REQUIRED_LANDED_CHECKS) {
    result("Sitemap contract", "SKIP", "EmDash 1.0.1 local runtime reports not configured for its built-in sitemap; require after the 1.2 upgrade.");
  } else {
    result("Sitemap availability", "FAIL", `/sitemap.xml returned ${sitemapResponse.status}`);
  }
} else if (sitemapResponse) {
  result("Sitemap availability", "FAIL", `/sitemap.xml returned ${sitemapResponse.status}`);
}

const robots = await inspect("/robots.txt", "robots.txt");
if (robots?.ok) result("Robots availability", "PASS", "/robots.txt is reachable");

for (const legacyPath of ["/shop/dinkus-template-managed-product", "/collections/tees"]) {
  const legacyResponse = await request(absoluteUrl(legacyPath));
  if (legacyResponse.status === 404) {
    result("Legacy product routes", "PASS", `${legacyPath} returns 404`);
  } else {
    result("Legacy product routes", "FAIL", `${legacyPath} returned ${legacyResponse.status}; legacy routes must be removed`);
  }
}

await drainDiscovered();
await verifyProductImages();

for (const path of sitemapPaths) {
  if (!pages.has(path)) {
    result(
      "Sitemap redirect",
      "FAIL",
      `${path} is listed in the sitemap but is not a canonical 200 HTML page`,
    );
  }
}

if (sitemapPaths.size) {
  for (const [path, page] of pages) {
    if (!sitemapPaths.has(path)) continue;
    if (!/^\/(?:products|categories)\//.test(path)) continue;
    if (page.canonical.length === 1) {
      try {
        const canonical = new URL(page.canonical[0]);
        if (canonical.href !== page.url.href) {
          result("Sitemap canonical", "FAIL", `${path} canonical is ${canonical.href}, not ${page.url.href}`);
        }
      } catch {
        result("Sitemap canonical", "FAIL", `${path} has an invalid canonical URL`);
      }
    } else {
      requiredOrSkip("Sitemap canonical", `${path} has no exactly-one canonical tag`);
    }
    if (page.noindex && !demoHost) {
      result("Sitemap indexability", "FAIL", `${path} is noindex`);
    } else if (page.noindex && demoHost) {
      result("Sitemap indexability", "PASS", `${path} is noindex under explicit demo-host policy`);
    }
  }
  if (sitemapPaths.has("/home")) result("Sitemap homepage", "FAIL", "/home must not be in the sitemap");
} else {
  result("Sitemap canonical", "SKIP", "No sitemap URLs were available to compare on this test origin");
}

const productPaths = [...pages.keys()].filter((path) => path.startsWith("/products/"));
requiredOrSkip(
  "Canonical product routes (#34)",
  "Product/category canonical routes are not landed",
  productPaths.every((path) => !path.endsWith("/")),
);
let jsonLdFailures = 0;
let commerceLinkedPages = 0;
for (const path of productPaths) {
  const page = pages.get(path);
  if (!page) continue;
  const products = page.jsonLd.filter((node) => node && typeof node === "object" && node["@type"] === "Product");
  const skuAttribute = page.body.match(/\bdata-product-sku\s*=\s*(?:"([^"]*)"|'([^']*)')/u);
  const sku = skuAttribute ? decodeHTMLAttribute(skuAttribute[1] ?? skuAttribute[2]) : undefined;
  const commerceLinked = Boolean(sku);
  if (commerceLinked) commerceLinkedPages += 1;
  if (products.length !== 1) {
    jsonLdFailures += 1;
    result("Product JSON-LD (#35)", "FAIL", `${path} ${commerceLinked ? `shows SKU ${sku}` : "is an editorial preview"} but has ${products.length} Product JSON-LD block(s)`);
    continue;
  }
  const product = products[0];
  const canonical = page.canonical[0];
  if (!commerceLinked && product.offers !== undefined) {
    jsonLdFailures += 1;
    result("Product JSON-LD (#35)", "FAIL", `${path} editorial preview emits an Offer`);
    continue;
  }
  if (commerceLinked && product.sku !== sku) {
    jsonLdFailures += 1;
    result("Product JSON-LD (#35)", "FAIL", `${path} JSON-LD sku ${product.sku} does not match visible SKU ${sku}`);
  }
  if (product.offers?.inventoryLevel !== undefined || Object.hasOwn(product, "inventoryLevel")) {
    jsonLdFailures += 1;
    result("Product JSON-LD (#35)", "FAIL", `${path} JSON-LD includes a stock quantity`);
  }
  if (canonical && product.url !== canonical) {
    jsonLdFailures += 1;
    result("Product JSON-LD (#35)", "FAIL", `${path} JSON-LD url ${product.url} does not match canonical ${canonical}`);
  }
  if (commerceLinked && product.offers && canonical && product.offers.url !== canonical) {
    jsonLdFailures += 1;
    result("Product JSON-LD (#35)", "FAIL", `${path} Offer url does not match canonical ${canonical}`);
  }
}
if (productPaths.length === 0) {
  result("Product JSON-LD (#35)", "PASS", "no product URL on this origin; that absence is not a failure");
} else if (jsonLdFailures === 0) {
  result(
    "Product JSON-LD (#35)",
    "PASS",
    `${commerceLinkedPages} commerce-linked product page(s) and ${productPaths.length - commerceLinkedPages} editorial page(s) of ${productPaths.length}`,
  );
}
function validFeedDocument(path, body) {
  try {
    if (!path.endsWith(".xml")) {
      const records = parseCsv(body, { bom: true, skip_empty_lines: true });
      const columns = ["id", "retailer_id", "title", "description", "availability", "condition", "price", "link", "image_link", "additional_image_link", "brand", "gtin", "mpn", "shipping"];
      return records.length > 0 && records[0].length === columns.length &&
        columns.every((column, index) => records[0][index] === column) &&
        records.every((record) => record.length === columns.length);
    }
    const parser = sax.parser(true, { xmlns: true, strictEntities: true });
    const stack = [];
    let roots = 0;
    let channels = 0;
    let valid = true;
    parser.onopentag = (tag) => {
      if (stack.length === 0) {
        roots += 1;
        valid &&= tag.name === "rss" && tag.attributes.version?.value === "2.0" &&
          tag.ns.g === "http://base.google.com/ns/1.0";
      } else if (stack.length === 1) {
        channels += 1;
        valid &&= tag.name === "channel";
      } else if (stack.length === 2) {
        valid &&= tag.name === "item";
      }
      stack.push(tag.name);
    };
    parser.onclosetag = () => stack.pop();
    parser.ontext = (text) => { if (stack.length <= 2 && text.trim()) valid = false; };
    parser.ondoctype = () => { valid = false; };
    parser.onerror = (error) => { throw error; };
    parser.write(body).close();
    return valid && roots === 1 && channels === 1 && stack.length === 0;
  } catch {
    return false;
  }
}

for (const feedPath of ["/feeds/google-merchant.xml", "/feeds/meta-catalog.csv"]) {
  const feedResponse = await request(absoluteUrl(feedPath));
  const slashResponse = await request(absoluteUrl(`${feedPath}/`));
  if (slashResponse.status === 200) {
    result("Feeds (#35)", "FAIL", `${feedPath}/ returned 200; a trailing slash must not be a second feed document`);
    continue;
  }
  const type = feedResponse.headers.get("content-type") ?? "";
  const feedType = feedPath.endsWith(".xml") ? type.includes("xml") : type.includes("csv");
  if (commerceLinkedPages > 0) {
    const productive = feedResponse.status === 200 && feedType && validFeedDocument(feedPath, await feedResponse.text());
    if (!productive) {
      result("Feeds (#35)", "FAIL", `${feedPath} returned ${feedResponse.status} ${type} without a valid feed document while ${commerceLinkedPages} commerce-linked product page(s) are public`);
    } else {
      result("Feeds (#35)", "PASS", `${feedPath} served for ${commerceLinkedPages} commerce-linked product page(s); slash twin status ${slashResponse.status}`);
    }
    continue;
  }
  if (feedResponse.status === 200) {
    const validFeed = feedType && validFeedDocument(feedPath, await feedResponse.text());
    result("Feeds (#35)", validFeed ? "PASS" : "FAIL", `${feedPath} ${validFeed ? "served a valid feed" : "did not serve a valid feed"} with no commerce-linked product page; slash twin status ${slashResponse.status}`);
  } else if (feedResponse.status === 503) {
    const body = await feedResponse.text();
    result("Feeds (#35)", "PASS", `${feedPath} fails closed (${feedResponse.status}) with no installed catalog; ${body.length} byte(s)`);
  } else if (productPaths.length === 0 && feedResponse.status === 404) {
    result("Feeds (#35)", "PASS", `no product URL or ${feedPath} on this origin; that absence is not a failure`);
  } else {
    result("Feeds (#35)", "FAIL", `${feedPath} returned ${feedResponse.status} with no commerce-linked product page; expected a valid 200 feed or fail-closed 503`);
  }
}

const failures = results.filter(({ status }) => status === "FAIL").length;
const skips = results.filter(({ status }) => status === "SKIP").length;
console.log(`verify-site: ${failures ? "failed" : "passed"} (${failures} failure(s), ${skips} skip(s), ${visited.size} URL(s) checked)`);
if (failures) {
  console.error(`visited: ${[...visited].join(" ")}`);
}
process.exitCode = failures ? 1 : 0;
