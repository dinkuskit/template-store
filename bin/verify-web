#!/usr/bin/env bash
set -euo pipefail

MODE="${1:-quick}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if [[ "$MODE" != "quick" && "$MODE" != "full" && "$MODE" != "browser" ]]; then
  echo "usage: bin/verify-web [quick|full|browser]" >&2
  exit 2
fi

# VERIFY_E2E_PROJECTS (comma-separated Playwright project names) narrows the
# browser tests; unset runs every project. CI splits desktop and phone into
# parallel jobs this way, each on its own runner with its own disposable store.
PLAYWRIGHT_PROJECT_ARGS=()
if [[ -n "${VERIFY_E2E_PROJECTS:-}" ]]; then
  IFS=',' read -r -a verify_e2e_projects <<<"$VERIFY_E2E_PROJECTS"
  for project in "${verify_e2e_projects[@]}"; do
    PLAYWRIGHT_PROJECT_ARGS+=("--project=$project")
  done
fi

pnpm prepare:sources

# The browser tests' proof store runs Commerce's Registry build (template-one-build-registry-20261031);
# the pinned Commerce is fetched and built once per commit before Playwright starts the stores.
if [[ "$MODE" != "quick" ]]; then
  node scripts/prepare-paired-commerce.mjs
fi

# browser runs only the build and the browser tests; the phone CI job uses it
# beside a full run that owns every other check.
if [[ "$MODE" == "browser" ]]; then
  pnpm exec astro build
  pnpm exec playwright test ${PLAYWRIGHT_PROJECT_ARGS[@]+"${PLAYWRIGHT_PROJECT_ARGS[@]}"}
  echo "verify-web: ${MODE} passed"
  exit 0
fi

pnpm exec astro check
pnpm exec vitest run
node --test tests/workflows/*.test.mjs
node scripts/check-features.mjs
node scripts/check-worktree-text.mjs
git diff --check

if [[ "$MODE" == "full" ]]; then
  pnpm exec astro build
  pnpm exec playwright test ${PLAYWRIGHT_PROJECT_ARGS[@]+"${PLAYWRIGHT_PROJECT_ARGS[@]}"}
  export NO_PROXY="${NO_PROXY:+$NO_PROXY,}127.0.0.1,localhost,::1"
  export no_proxy="${no_proxy:+$no_proxy,}127.0.0.1,localhost,::1"
  VERIFY_SITE_PORT="${VERIFY_SITE_PORT:-4640}"
  VERIFY_SITE_LOG="${TMPDIR:-/tmp}/dinkuskit-verify-site-${VERIFY_SITE_PORT}.log"
  pnpm exec astro preview --host 127.0.0.1 --port "$VERIFY_SITE_PORT" </dev/null >"$VERIFY_SITE_LOG" 2>&1 &
  VERIFY_SITE_PID=$!
  cleanup_verify_site() {
    pkill -P "$VERIFY_SITE_PID" 2>/dev/null || true
    kill "$VERIFY_SITE_PID" 2>/dev/null || true
    wait "$VERIFY_SITE_PID" 2>/dev/null || true
  }
  trap cleanup_verify_site EXIT
  for attempt in {1..60}; do
    if curl --silent --fail --max-time 15 "http://127.0.0.1:${VERIFY_SITE_PORT}/" >/dev/null; then
      break
    fi
    sleep 1
  done
  if ! curl --silent --fail --max-time 15 "http://127.0.0.1:${VERIFY_SITE_PORT}/" >/dev/null; then
    echo "::error::Astro preview on 127.0.0.1:${VERIFY_SITE_PORT} never returned HTTP 2xx" >&2
    cat "$VERIFY_SITE_LOG" >&2
    exit 1
  fi
  if ! bin/verify-site "http://127.0.0.1:${VERIFY_SITE_PORT}" | tee "${VERIFY_SITE_LOG}.results"; then
    echo "::error::bin/verify-site failed against http://127.0.0.1:${VERIFY_SITE_PORT}" >&2
    exit 1
  fi
fi

echo "verify-web: ${MODE} passed"
