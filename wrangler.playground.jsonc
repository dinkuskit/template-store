{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dinkuskit-template-playground",
  "main": "./src/playground-worker.ts",
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DINKUS_DEMO_NOINDEX": "1",
    "PLAYGROUND_RATE_LIMITER_BINDING": "PLAYGROUND_CREATION_LIMITER"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PLAYGROUND_DB",
        "class_name": "EmDashPreviewDB"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EmDashPreviewDB"]
    }
  ]
  // Infra-keeper: add a Cloudflare Rate Limit binding named
  // PLAYGROUND_CREATION_LIMITER here, with a modest per-IP creation limit.
  // The project-owned middleware already consumes that binding on
  // /_playground/init. Do not add payment, coupon, D1, or secret bindings.
}
