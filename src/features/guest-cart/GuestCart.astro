---
import { GUEST_CHECKOUT_LABEL, GUEST_CHECKOUT_REASON, GUEST_CHECKOUT_READY_LABEL } from "./index.js";
import type { GuestCheckoutAdmission } from "./index.js";

interface Props {
  checkoutAdmission?: GuestCheckoutAdmission | null;
}

const { checkoutAdmission = null } = Astro.props;
---
<section class="guest-cart" aria-labelledby="guest-cart-title" data-guest-cart data-guest-cart-page="cart" data-guest-checkout-admitted={checkoutAdmission ? "true" : "false"}>
  <h1 id="guest-cart-title">Cart</h1>
  <p data-guest-cart-status role="status" hidden></p>
  <p data-guest-cart-empty hidden tabindex="-1">Your cart is empty. Listed shop products can be added when they are currently priced and sellable.</p>
  <div data-guest-cart-lines></div>
  <p class="guest-cart-subtotal" data-guest-cart-subtotal hidden>Subtotal <strong data-guest-cart-subtotal-amount></strong></p>
  <div class="guest-cart-checkout">
    <button type="button" data-guest-cart-checkout data-guest-cart-proceed disabled>{checkoutAdmission ? GUEST_CHECKOUT_READY_LABEL : GUEST_CHECKOUT_LABEL}</button>
    <p data-guest-cart-checkout-reason>{checkoutAdmission ? "" : GUEST_CHECKOUT_REASON}</p>
    <button type="button" data-guest-cart-retry hidden>Try again</button>
    <a data-guest-cart-resume hidden rel="noopener noreferrer">Return to secure checkout</a>
    <button type="button" data-guest-cart-recover hidden>Check checkout status</button>
  </div>
</section>
<style>
  .guest-cart{width:min(70rem,calc(100% - 2rem));margin:3rem auto;min-height:65vh;overflow-wrap:anywhere}
  h1{font-size:clamp(2.5rem,6vw,5rem);letter-spacing:-.05em;margin:0 0 1.5rem}
  [data-guest-cart-status],[data-guest-cart-empty],[data-guest-cart-checkout-reason]{color:var(--store-muted);line-height:1.5}
  [data-guest-cart-status][role="alert"]{color:var(--store-alert-ink);background:var(--store-alert);padding:.8rem 1rem;border-radius:.6rem}
  [data-guest-cart-lines]{display:grid;gap:1rem;margin:1.5rem 0}
  .guest-cart-subtotal[hidden]{display:none}
  .guest-cart-subtotal{display:flex;justify-content:space-between;gap:1rem;max-width:32rem;margin:1rem 0 0;padding-top:1rem;border-top:1px solid var(--store-line);font-size:1.25rem}
  .guest-cart-checkout{margin-top:2rem}
  .guest-cart-checkout button{margin:.4rem .6rem .4rem 0;padding:.7rem 1rem;border:1px solid var(--store-line);border-radius:.4rem;background:var(--store-surface);font:inherit;font-weight:800;cursor:pointer}
  .guest-cart-checkout [data-guest-cart-checkout]:not(:disabled){background:var(--dinkus-action-background);color:var(--dinkus-action-color);border-color:var(--dinkus-action-background)}
  .guest-cart-checkout [data-guest-cart-resume]{display:inline-block;margin:.4rem .6rem .4rem 0;padding:.7rem 1rem;border:1px solid var(--store-line);border-radius:.4rem;background:var(--store-surface);color:inherit;font-weight:800;text-decoration:underline;text-underline-offset:.2em}
  .guest-cart-checkout [data-guest-cart-resume][hidden]{display:none}
  [data-guest-cart-checkout]:disabled{color:var(--store-muted);cursor:not-allowed}
  .guest-cart :global([data-guest-cart-line]){display:grid;grid-template-columns:auto minmax(0,1fr);gap:1rem 1.25rem;align-items:start;padding:1.5rem;border:1px solid var(--store-line);border-radius:.85rem;background:var(--store-surface);min-width:0;overflow-wrap:anywhere}
  .guest-cart :global(.guest-cart-line-media){width:clamp(5.5rem,18vw,8.5rem);aspect-ratio:4/3;box-sizing:border-box;padding:.35rem;border:1px solid var(--store-line);border-radius:.65rem;background:#f7f4ec;box-shadow:inset 0 0 0 1px rgba(25,25,22,.06);overflow:hidden}
  .guest-cart :global(.guest-cart-line-media img){display:block;width:100%;height:100%;object-fit:cover;border-radius:.4rem;background:#e9e8df}
  .guest-cart :global([data-guest-cart-thumbnail-placeholder]){display:grid;place-items:center;height:100%;margin:0;border-radius:.4rem;background:#e9e8df;color:var(--store-muted);font-size:.85rem;font-weight:700;text-align:center}
  .guest-cart :global([data-guest-cart-line-copy]){min-width:0}
  .guest-cart :global([data-guest-cart-line] h2){font-size:1.5rem;margin:0 0 1rem}
  .guest-cart :global(.price){display:flex;gap:.65rem;flex-wrap:wrap;font-size:1.4rem}
  .guest-cart :global(s){color:var(--store-muted)}
  .guest-cart :global([data-guest-cart-line-reason]){color:var(--store-muted);line-height:1.5}
  .guest-cart :global(.guest-cart-qty){grid-column:1/-1;display:flex;flex-wrap:wrap;gap:.75rem;align-items:center;margin:.25rem 0 0;min-width:0}
  .guest-cart :global([data-guest-cart-qty]){width:4.5rem;max-width:100%;padding:.45rem .55rem;border:1px solid var(--store-line);border-radius:.4rem;font:inherit;background:var(--store-surface)}
  .guest-cart :global([data-guest-cart-remove]){grid-column:1/-1;justify-self:start;padding:.7rem 1rem;border:1px solid var(--store-line);border-radius:.4rem;background:var(--store-surface);font:inherit;font-weight:800;cursor:pointer}
  .guest-cart :global([data-guest-cart-qty]:focus-visible),
  .guest-cart :global([data-guest-cart-remove]:focus-visible),
  .guest-cart :global([data-guest-cart-retry]:focus-visible),
  .guest-cart :global([data-guest-cart-resume]:focus-visible),
  .guest-cart :global([data-guest-cart-empty]:focus-visible){outline:3px solid #215cc8;outline-offset:3px}
  @media(max-width:45rem){.guest-cart :global([data-guest-cart-line]),.guest-cart :global(.guest-cart-qty){min-width:0}}
</style>
<script>
  import { hydrateGuestCartPage } from "./guest-cart-client.ts";
  hydrateGuestCartPage();
</script>
