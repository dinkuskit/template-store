---
const { contactHref } = Astro.props;
---
<section class="guest-checkout-return" data-guest-checkout-return aria-labelledby="guest-checkout-return-title">
  <h1 id="guest-checkout-return-title">Order confirmation</h1>
  <p data-guest-checkout-return-status role="status">Checking the saved checkout status.</p>
  {contactHref && <p data-guest-checkout-contact>Need help? <a href={contactHref}>Contact the store</a>.</p>}
  <div class="ephemera-receipt-card" data-guest-checkout-order data-ephemera-receipt hidden>
    <svg class="ephemera-stamp-defs" width="0" height="0" aria-hidden="true">
      <defs>
        <filter id="ephemera-stamp-erosion" x="-10%" y="-10%" width="120%" height="120%">
          <feTurbulence type="fractalNoise" baseFrequency="0.085" numOctaves="4" seed="11" result="stamp-noise" />
          <feDisplacementMap in="SourceGraphic" in2="stamp-noise" scale="2.6" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>
    <div class="guest-checkout-order-heading">
      <h2 data-guest-checkout-order-number>Order confirmed</h2>
      <span class="guest-checkout-test-badge" data-guest-checkout-test hidden>TEST</span>
      <span class="ephemera-rubber-stamp" data-ephemera-stamp aria-hidden="true">
        <span class="ephemera-rubber-stamp__inner" data-ephemera-stamp-text>SETTLED · COMMERCE</span>
      </span>
    </div>
    <h3>Items</h3>
    <ul data-guest-checkout-order-items></ul>
    <dl data-guest-checkout-order-totals></dl>
    <section
      class="guest-checkout-destination"
      aria-labelledby="guest-checkout-destination-title"
      data-guest-checkout-destination
      data-guest-checkout-shipping
      hidden
    >
      <h3 id="guest-checkout-destination-title">Shipping &amp; confirmation details</h3>
      <div class="guest-checkout-destination__grid">
        <div class="guest-checkout-destination__item" data-guest-checkout-email-row hidden>
          <span class="guest-checkout-destination__label">Confirmation email</span>
          <p class="guest-checkout-destination__value" data-guest-checkout-email></p>
        </div>
        <div class="guest-checkout-destination__item" data-guest-checkout-recipient-row hidden>
          <span class="guest-checkout-destination__label">Recipient</span>
          <p class="guest-checkout-destination__value" data-guest-checkout-recipient></p>
        </div>
        <div class="guest-checkout-destination__item" data-guest-checkout-address-row hidden>
          <span class="guest-checkout-destination__label">Shipping address</span>
          <p class="guest-checkout-destination__value" data-guest-checkout-address></p>
        </div>
        <div class="guest-checkout-destination__item" data-guest-checkout-shipping-method-row hidden>
          <span class="guest-checkout-destination__label">Shipping method</span>
          <p class="guest-checkout-destination__value" data-guest-checkout-shipping-method></p>
        </div>
      </div>
    </section>
    <h3>What happens next</h3>
    <p>A confirmation email is coming. When your order ships, a shipping email with tracking will arrive.</p>
    {contactHref && <p data-guest-checkout-contact>Questions? <a href={contactHref}>Contact the store</a>.</p>}
    <div class="ephemera-receipt-barcode" data-ephemera-barcode aria-hidden="true"></div>
  </div>
  <a data-guest-checkout-retry hidden rel="noopener noreferrer">Continue to secure checkout</a>
  <div class="guest-checkout-actions" data-guest-checkout-actions>
    <a class="guest-checkout-continue" href="/">Continue shopping</a>
    <a class="guest-checkout-account" data-guest-checkout-account href="/account">Shopper account</a>
  </div>
  <button type="button" data-guest-checkout-status-retry hidden>Check status again</button>
</section>
<script>
  import { hydrateGuestCheckoutReturn } from "./guest-cart-client.ts";
  hydrateGuestCheckoutReturn();

  function fnv1aHash(str: string): number {
    let hash = 0x811c9dc5;
    for (let i = 0; i < str.length; i += 1) {
      hash ^= str.charCodeAt(i);
      hash = Math.imul(hash, 0x01000193) >>> 0;
    }
    return hash >>> 0;
  }

  function renderBarcodeSvg(code: string): string {
    const clean = String(code || "DINKUS-0000").toUpperCase();
    const bars: string[] = [];
    let x = 8;
    bars.push(`<rect x="${x}" y="4" width="2" height="34" fill="currentColor"/>`);
    x += 4;
    bars.push(`<rect x="${x}" y="4" width="1" height="34" fill="currentColor"/>`);
    x += 3;
    for (let i = 0; i < clean.length; i += 1) {
      const h = fnv1aHash(`${clean}:${i}`);
      for (let b = 0; b < 4; b += 1) {
        const w = ((h >>> (b * 4)) & 3) + 1;
        const gap = ((h >>> (b * 4 + 2)) & 2) + 1;
        bars.push(`<rect x="${x}" y="4" width="${w}" height="30" fill="currentColor"/>`);
        x += w + gap;
      }
    }
    bars.push(`<rect x="${x}" y="4" width="1" height="34" fill="currentColor"/>`);
    x += 3;
    bars.push(`<rect x="${x}" y="4" width="2" height="34" fill="currentColor"/>`);
    const totalW = x + 10;
    return `<svg class="ephemera-barcode-svg" viewBox="0 0 ${totalW} 48" width="100%" height="44" role="img" aria-label="Order barcode ${clean}">${bars.join("")}<text x="${totalW / 2}" y="45" text-anchor="middle" font-size="8.5" font-family="var(--font-mono, monospace)" letter-spacing="2.2" fill="currentColor">${clean}</text></svg>`;
  }

  const orderBlock = document.querySelector<HTMLElement>("[data-guest-checkout-order]");
  if (orderBlock) {
    const syncReceiptEphemera = () => {
      if (orderBlock.hidden) return;
      const numEl = orderBlock.querySelector<HTMLElement>("[data-guest-checkout-order-number]");
      const testBadge = orderBlock.querySelector<HTMLElement>("[data-guest-checkout-test]");
      const stampText = orderBlock.querySelector<HTMLElement>("[data-ephemera-stamp-text]");
      const barcodeHost = orderBlock.querySelector<HTMLElement>("[data-ephemera-barcode]");
      const rawOrder = (numEl?.textContent || "ORDER-CONFIRMED").replace(/^Order\s+/iu, "").trim();
      const stampLabel = testBadge && !testBadge.hidden ? "PAID · STRIPE TEST" : "SETTLED · COMMERCE";
      // Writing text always replaces the node, which this observer sees; write only on change.
      if (stampText && stampText.textContent !== stampLabel) stampText.textContent = stampLabel;
      if (barcodeHost && barcodeHost.dataset.renderedCode !== rawOrder) {
        barcodeHost.dataset.renderedCode = rawOrder;
        barcodeHost.innerHTML = renderBarcodeSvg(`DK-${rawOrder}`);
      }
    };
    syncReceiptEphemera();
    const obs = new MutationObserver(syncReceiptEphemera);
    obs.observe(orderBlock, { attributes: true, childList: true, subtree: true });
  }
</script>
