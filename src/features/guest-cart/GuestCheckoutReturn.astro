---
import type { CheckoutReturn } from "./server-return.js";
import { receiptBarcodeSvg } from "./receipt-barcode.js";

interface Props {
  result: CheckoutReturn;
  contactHref?: string | undefined;
}

// Drawn on the server from Commerce's paid order, with no script (template-thank-you-server-20261113).
const { result, contactHref } = Astro.props;
const order = result.kind === "paid" ? result.order : null;
const title = order ? "Order confirmation"
  : result.kind === "confirming" ? "Confirming your payment"
  : result.kind === "slow" ? "Still confirming your payment"
  : result.kind === "no-cart" ? "Thank you"
  : "We couldn't confirm your order";
const message = order ? "Order confirmed."
  // Only Commerce's paid answer says the payment went through; until then the page says it is still checking.
  : result.kind === "confirming" ? "We are checking with the payment provider whether your payment is complete. This page updates in a few seconds."
  : result.kind === "slow" ? "Your payment is not confirmed yet. If you paid, your confirmation email comes once it is. If you did not finish paying, your items are still in your cart."
  : result.kind === "no-cart" ? "If you just paid, your confirmation email has your order details. Signed-in shoppers find every order in their account."
  : contactHref ? "We couldn't confirm your order just now. Check your email, or contact us." : "We couldn't confirm your order just now. Check your email.";
const statusRole = result.kind === "unavailable" ? "alert" : "status";
const hasDestination = Boolean(order && (order.email || order.recipient || order.address || order.shippingMethod));
---
<section class="guest-checkout-return" data-guest-checkout-return data-guest-checkout-return-state={result.kind} aria-labelledby="guest-checkout-return-title">
  <h1 id="guest-checkout-return-title">{title}</h1>
  <p data-guest-checkout-return-status role={statusRole}>{message}</p>
  {!order && contactHref && <p data-guest-checkout-contact>Need help? <a href={contactHref}>Contact the store</a>.</p>}
  {order && (
    <div class="ephemera-receipt-card" data-guest-checkout-order data-ephemera-receipt>
      <svg class="ephemera-stamp-defs" width="0" height="0" aria-hidden="true">
        <defs>
          <filter id="ephemera-stamp-erosion" x="-10%" y="-10%" width="120%" height="120%">
            <feTurbulence type="fractalNoise" baseFrequency="0.085" numOctaves="4" seed="11" result="stamp-noise" />
            <feDisplacementMap in="SourceGraphic" in2="stamp-noise" scale="2.6" xChannelSelector="R" yChannelSelector="G" />
          </filter>
        </defs>
      </svg>
      <div class="guest-checkout-order-heading">
        <h2 data-guest-checkout-order-number>Order {order.orderNumber}</h2>
        {order.test && <span class="guest-checkout-test-badge" data-guest-checkout-test>TEST</span>}
        <span class="ephemera-rubber-stamp" data-ephemera-stamp aria-hidden="true">
          <span class="ephemera-rubber-stamp__inner" data-ephemera-stamp-text>{order.test ? "PAID · STRIPE TEST" : "SETTLED · COMMERCE"}</span>
        </span>
      </div>
      <h3>Items</h3>
      <ul data-guest-checkout-order-items>
        {order.lines.map((line) => (
          <li class="guest-checkout-item" data-guest-checkout-item={line.id} data-guest-checkout-item-sku={line.sku ?? undefined}>
            {line.thumbnail
              ? <img class="guest-checkout-item-thumb" data-guest-checkout-item-thumb data-guest-checkout-item-thumbnail src={line.thumbnail.src} alt={line.thumbnail.alt} width="56" height="56" loading="lazy" decoding="async" />
              : <span class="guest-checkout-item-thumb guest-checkout-item-thumb--placeholder" data-guest-checkout-item-thumb-placeholder>No image</span>}
            <span class="guest-checkout-item-details" data-guest-checkout-item-details>
              {line.text}
              {line.variant && <small class="guest-checkout-item-variant" data-guest-checkout-item-variant>{line.variant}</small>}
            </span>
            <span class="guest-checkout-item-amount" data-guest-checkout-item-amount>{line.amount}</span>
          </li>
        ))}
      </ul>
      <dl data-guest-checkout-order-totals>
        {order.totals.map((row) => (
          <div class={row.label === "Total" ? "total" : undefined}><dt>{row.label}</dt><dd>{row.amount}</dd></div>
        ))}
      </dl>
      {hasDestination && (
        <section class="guest-checkout-destination" aria-labelledby="guest-checkout-destination-title" data-guest-checkout-destination data-guest-checkout-shipping>
          <h3 id="guest-checkout-destination-title">Shipping &amp; confirmation details</h3>
          <div class="guest-checkout-destination__grid">
            {order.email && (
              <div class="guest-checkout-destination__item" data-guest-checkout-email-row>
                <span class="guest-checkout-destination__label">Confirmation email</span>
                <p class="guest-checkout-destination__value" data-guest-checkout-email>{order.email}</p>
              </div>
            )}
            {order.recipient && (
              <div class="guest-checkout-destination__item" data-guest-checkout-recipient-row>
                <span class="guest-checkout-destination__label">Recipient</span>
                <p class="guest-checkout-destination__value" data-guest-checkout-recipient>{order.recipient}</p>
              </div>
            )}
            {order.address && (
              <div class="guest-checkout-destination__item" data-guest-checkout-address-row>
                <span class="guest-checkout-destination__label">Shipping address</span>
                <p class="guest-checkout-destination__value" data-guest-checkout-address>{order.address}</p>
              </div>
            )}
            {order.billingAddress && (
              <div class="guest-checkout-destination__item" data-guest-checkout-billing-row>
                <span class="guest-checkout-destination__label">Billing address</span>
                <p class="guest-checkout-destination__value" data-guest-checkout-billing>{order.billingAddress}</p>
              </div>
            )}
            {order.shippingMethod && (
              <div class="guest-checkout-destination__item" data-guest-checkout-shipping-method-row>
                <span class="guest-checkout-destination__label">Shipping method</span>
                <p class="guest-checkout-destination__value" data-guest-checkout-shipping-method>{order.shippingMethod}</p>
              </div>
            )}
          </div>
        </section>
      )}
      <h3>What happens next</h3>
      <p>A confirmation email is coming. When your order ships, a shipping email with tracking will arrive.</p>
      {contactHref && <p data-guest-checkout-contact>Questions? <a href={contactHref}>Contact the store</a>.</p>}
      <div class="ephemera-receipt-barcode" data-ephemera-barcode aria-hidden="true" set:html={receiptBarcodeSvg(`DK-${order.orderNumber}`)}></div>
    </div>
  )}
  {result.kind === "confirming" && (
    <a data-guest-checkout-status-retry href={result.refreshUrl}>Check now</a>
  )}
  {(result.kind === "slow" || result.kind === "unavailable") && (
    <a data-guest-checkout-status-retry href="/checkout/success">Check status again</a>
  )}
  {result.kind === "slow" && <a data-guest-checkout-back-to-cart href="/cart">Back to your cart</a>}
  <div class="guest-checkout-actions" data-guest-checkout-actions>
    <a class="guest-checkout-continue" href="/">Continue shopping</a>
    <a class="guest-checkout-account" data-guest-checkout-account href="/account">Shopper account</a>
  </div>
</section>
