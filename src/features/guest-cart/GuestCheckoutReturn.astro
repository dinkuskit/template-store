---
const { contactHref } = Astro.props;
---
<section class="guest-checkout-return" data-guest-checkout-return aria-labelledby="guest-checkout-return-title">
  <h1 id="guest-checkout-return-title">Order confirmation</h1>
  <p data-guest-checkout-return-status role="status">Checking the saved checkout status.</p>
  {contactHref && <p data-guest-checkout-contact>Need help? <a href={contactHref}>Contact the store</a>.</p>}
  <div data-guest-checkout-order hidden>
    <div class="guest-checkout-order-heading">
      <h2 data-guest-checkout-order-number>Order confirmed</h2>
      <span class="guest-checkout-test-badge" data-guest-checkout-test hidden>TEST</span>
    </div>
    <h3>Items</h3>
    <ul data-guest-checkout-order-items></ul>
    <dl data-guest-checkout-order-totals></dl>
    <h3>What happens next</h3>
    <p>A confirmation email is coming. When your order ships, a shipping email with tracking will arrive.</p>
    {contactHref && <p data-guest-checkout-contact>Questions? <a href={contactHref}>Contact the store</a>.</p>}
  </div>
  <a data-guest-checkout-retry hidden rel="noopener noreferrer">Continue to secure checkout</a>
  <a class="guest-checkout-continue" href="/">Continue shopping</a>
  <button type="button" data-guest-checkout-status-retry hidden>Check status again</button>
</section>
<script>
  import { hydrateGuestCheckoutReturn } from "./guest-cart-client.ts";
  hydrateGuestCheckoutReturn();
</script>
