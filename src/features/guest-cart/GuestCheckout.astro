---
import { GUEST_CHECKOUT_LABEL, GUEST_CHECKOUT_REASON, GUEST_CHECKOUT_READY_LABEL } from "./index.js";
import type { GuestCheckoutAdmission } from "./index.js";
import type { ServerCartPage } from "./server-view.js";
import type { ContactFieldError, ContactFormValues } from "./server-cart.js";
import { formatUsdMinor } from "../store-shell/price.js";

interface Props {
  checkoutAdmission?: GuestCheckoutAdmission | null;
  shippingMode?: "free" | "flat" | null;
  shippingMinor?: string | null;
  /** The cart the server read for this page. */
  page: ServerCartPage;
  /** What the shopper posted, kept when checkout refused it. */
  values?: ContactFormValues | null;
  error?: (ContactFieldError | Readonly<{ field: null; message: string }>) | null;
}

const {
  checkoutAdmission = null,
  shippingMode = null,
  shippingMinor = null,
  page,
  values = null,
  error = null,
} = Astro.props;
const { view } = page;
// Shown disabled until Commerce publishes the store's allowed shipping countries.
const COMING_SOON_SHIPPING_COUNTRIES = ["Canada", "United Kingdom", "Australia", "Germany", "France", "Japan"];
// A billing address may be in every country, so its list holds each country the runtime names.
const regionNames = new Intl.DisplayNames(["en"], { type: "region" });
const NOT_COUNTRIES = new Set(["EU", "EZ", "UN", "QO", "XA", "XB", "ZZ"]);
const BILLING_COUNTRIES = Array.from({ length: 26 * 26 }, (_, i) => String.fromCharCode(65 + Math.floor(i / 26), 65 + (i % 26)))
  .flatMap((code) => {
    const name = NOT_COUNTRIES.has(code) ? code : regionNames.of(code);
    return name && name !== code ? [{ code, name }] : [];
  })
  .sort((a, b) => a.name.localeCompare(b.name, "en"));
const value = (name: string) => values?.[name] ?? "";
// "Same as delivery" starts ticked (billing-address-v1); a refused post keeps the shopper's choice.
const billingSame = values ? values.billingSame === "on" : true;
const fieldError = (name: string) => error && error.field === name ? error.message : null;
// A correction sits beside its control, is tied to it for screen readers, and takes focus (template-store#223).
// autofocus works without script; a refused post is redrawn here with one field in error.
const errorId = (name: string) => `guest-cart-${name.replace(/\[|\]/gu, (bracket) => bracket === "[" ? "-" : "").replace(/[A-Z]/gu, (c) => `-${c.toLowerCase()}`)}-error`;
const invalidAttrs = (name: string) => error && error.field === name
  ? { "aria-invalid": "true" as const, "aria-describedby": errorId(name), autofocus: true }
  : {};
const canStart = Boolean(checkoutAdmission) && view.checkoutEnabled && !page.openPayment;
const shippingText = shippingMode === "free" ? "Free"
  : shippingMode === "flat" && shippingMinor ? formatUsdMinor(shippingMinor) : "Calculated at checkout";
const address = (kind: "delivery" | "billing") => [
  { field: "name", label: kind === "delivery" ? "Recipient" : "Billing name", auto: "name", required: true },
  { field: "line1", label: kind === "delivery" ? "Address line 1" : "Billing address line 1", auto: "address-line1", required: true },
  { field: "line2", label: kind === "delivery" ? "Address line 2" : "Billing address line 2", auto: "address-line2", required: false },
  { field: "city", label: kind === "delivery" ? "City" : "Billing city", auto: "address-level2", required: true },
  { field: "region", label: kind === "delivery" ? "State or region" : "Billing state or region", auto: "address-level1", required: false },
  { field: "postalCode", label: kind === "delivery" ? "Postal code" : "Billing postal code", auto: "postal-code", required: true },
];
const dataName = (field: string) => field === "postalCode" ? "postal-code" : field;
---
<section
  class="guest-checkout"
  aria-labelledby="guest-checkout-title"
  data-guest-cart
  data-guest-checkout-page
  data-server-checkout
  data-guest-checkout-admitted={checkoutAdmission ? "true" : "false"}
  data-checkout-shipping-mode={shippingMode ?? undefined}
  data-checkout-shipping-minor={shippingMinor ?? undefined}
>
  <div class="guest-checkout-header">
    <h1 id="guest-checkout-title">Checkout</h1>
    <a href="/cart" class="guest-checkout-back" data-checkout-back-to-cart>Back to cart</a>
  </div>
  {error && error.field === null && <p data-guest-cart-status role="alert">{error.message}</p>}
  {page.error && <p data-guest-cart-status role="alert">{page.error}</p>}
  {view.empty ? <p data-guest-cart-empty tabindex="-1">Your cart is empty. <a href="/cart">Return to cart</a> or <a href="/">continue shopping</a>.</p> : (
  <div class="guest-checkout-grid">
    <form class="guest-checkout-vault" method="post" action="/checkout" data-checkout-vault data-checkout-form novalidate>
      <div class="guest-checkout-vault__header">
        <p class="guest-checkout-vault__eyebrow">Secure Checkout Vault</p>
        <h2>Contact &amp; Delivery</h2>
      </div>
      <fieldset class="guest-cart-contact" data-guest-cart-contact disabled={!canStart}>
        <legend>Checkout contact</legend>
        <p>Commerce uses your email for checkout. Every order needs a billing address; a delivery address is required only when the basket contains a physical item.</p>
        <label for="guest-cart-email">Email</label>
        <input id="guest-cart-email" name="email" data-guest-cart-email type="email" maxlength="254" autocomplete="email" value={value("email")} {...invalidAttrs("email")} />
        {fieldError("email") && <p id={errorId("email")} data-guest-cart-contact-error="email" role="alert">{fieldError("email")}</p>}
        {view.needsDelivery && (
          <div class="guest-cart-delivery" data-guest-cart-delivery>
            <h2>Delivery address</h2>
            <p>Complete these fields for a physical order.</p>
            {address("delivery").map(({ field, label, auto, required }) => (
              <>
                <label for={`guest-cart-delivery-${dataName(field)}`}>{label}{!required && <span> (optional)</span>}{field === "region" && <span> (required for United States delivery)</span>}</label>
                <input id={`guest-cart-delivery-${dataName(field)}`} name={`delivery[${field}]`} {...{ [`data-guest-cart-delivery-${dataName(field)}`]: "" }} maxlength="200" autocomplete={`shipping ${auto}`} value={value(`delivery[${field}]`)} {...invalidAttrs(`delivery[${field}]`)} />
                {fieldError(`delivery[${field}]`) && <p id={errorId(`delivery[${field}]`)} data-guest-cart-contact-error={`delivery-${dataName(field)}`} role="alert">{fieldError(`delivery[${field}]`)}</p>}
              </>
            ))}
            <label for="guest-cart-delivery-country">Country</label>
            <select id="guest-cart-delivery-country" name="delivery[country]" data-guest-cart-delivery-country autocomplete="shipping country" {...invalidAttrs("delivery[country]")}>
              <option value="">Select a country</option>
              <option value="US" selected={value("delivery[country]").toUpperCase() === "US"}>United States</option>
              {COMING_SOON_SHIPPING_COUNTRIES.map((name) => <option value="" disabled>{name} (coming soon)</option>)}
            </select>
            {fieldError("delivery[country]") && <p id={errorId("delivery[country]")} data-guest-cart-contact-error="delivery-country" role="alert">{fieldError("delivery[country]")}</p>}
          </div>
        )}
        {view.needsDelivery && (
          <label class="guest-cart-billing-same" data-guest-cart-billing-same-row>
            <input type="checkbox" name="billingSame" data-guest-cart-billing-same checked={billingSame} />
            Billing address same as delivery address
          </label>
        )}
        <div class="guest-cart-delivery" data-guest-cart-billing data-billing-optional={view.needsDelivery ? "when-same" : undefined}>
          <h2>Billing address</h2>
          <p>{view.needsDelivery ? "The address for the card you pay with. Leave it empty when it matches the delivery address." : "The address for the card you pay with."}</p>
          {address("billing").map(({ field, label, auto, required }) => (
            <>
              <label for={`guest-cart-billing-${dataName(field)}`}>{label}{!required && <span> (optional)</span>}</label>
              <input id={`guest-cart-billing-${dataName(field)}`} name={`billing[${field}]`} {...{ [`data-guest-cart-billing-${dataName(field)}`]: "" }} maxlength="200" autocomplete={`billing ${auto}`} value={value(`billing[${field}]`)} {...invalidAttrs(`billing[${field}]`)} />
              {fieldError(`billing[${field}]`) && <p id={errorId(`billing[${field}]`)} data-guest-cart-contact-error={`billing-${dataName(field)}`} role="alert">{fieldError(`billing[${field}]`)}</p>}
            </>
          ))}
          <label for="guest-cart-billing-country">Billing country</label>
          <select id="guest-cart-billing-country" name="billing[country]" data-guest-cart-billing-country autocomplete="billing country" {...invalidAttrs("billing[country]")}>
            <option value="">Select a country</option>
            {BILLING_COUNTRIES.map(({ code, name }) => <option value={code} selected={value("billing[country]").toUpperCase() === code}>{name}</option>)}
          </select>
          {fieldError("billing[country]") && <p id={errorId("billing[country]")} data-guest-cart-contact-error="billing-country" role="alert">{fieldError("billing[country]")}</p>}
        </div>
      </fieldset>
      <div class="guest-cart-coupon" data-guest-cart-coupon-box aria-disabled="true">
        <label for="guest-cart-coupon">Coupon code</label>
        <input id="guest-cart-coupon" data-guest-cart-coupon type="text" placeholder="Coupons coming soon" aria-describedby="guest-cart-coupon-note" autocomplete="off" disabled />
        <p id="guest-cart-coupon-note">Discount codes can't be used yet.</p>
      </div>
      <div class="guest-checkout-actions" data-checkout-payment-handoff>
        <p class="guest-checkout-handoff-note" data-checkout-payment-note>Payment is processed securely through the store's configured payment provider.</p>
        {page.openPayment ? (
          <>
            <a data-guest-cart-resume href={page.openPayment} rel="noopener noreferrer">Return to secure checkout</a>
            <p data-guest-cart-checkout-reason>Your payment is already open. Finish paying there.</p>
          </>
        ) : (
          <>
            <button type="submit" data-guest-cart-checkout disabled={!canStart}>{canStart ? "Continue to secure checkout" : checkoutAdmission ? GUEST_CHECKOUT_READY_LABEL : GUEST_CHECKOUT_LABEL}</button>
            <p data-guest-cart-checkout-reason>{canStart ? view.checkoutReason : checkoutAdmission ? view.checkoutReason : GUEST_CHECKOUT_REASON}</p>
          </>
        )}
      </div>
    </form>
    <aside class="guest-checkout-manifest" aria-labelledby="guest-checkout-manifest-title" data-checkout-manifest>
      <div class="guest-checkout-manifest__header">
        <h2 id="guest-checkout-manifest-title">Order Manifest</h2>
        <a href="/cart" data-checkout-edit-cart>Edit cart</a>
      </div>
      <div class="guest-checkout-manifest__lines" data-guest-cart-lines>
        {view.lines.map((line) => (
          <article data-guest-cart-line={line.id}>
            <div class="guest-cart-line-media" data-guest-cart-line-thumbnail>
              {line.thumbnail
                ? <img data-guest-cart-thumbnail-img src={line.thumbnail.src} alt={line.thumbnail.alt} width="160" height="120" loading="lazy" />
                : <p data-guest-cart-thumbnail-placeholder>No image</p>}
            </div>
            <div data-guest-cart-line-copy>
              <h2>{line.name}</h2>
              <p data-guest-cart-line-quantity>Quantity {line.quantity}</p>
              {line.lineTotalText && <p data-guest-cart-line-total>Line total <strong>{line.lineTotalText}</strong></p>}
              {line.reason && <p data-guest-cart-line-reason={line.reasonCode ?? ""}>{line.reason}</p>}
            </div>
          </article>
        ))}
      </div>
      <dl class="guest-checkout-breakdown" data-checkout-breakdown data-checkout-currency="USD" data-checkout-tax-minor="0">
        {view.subtotalText && (
          <div class="guest-checkout-breakdown__row" data-guest-cart-subtotal>
            <dt>Subtotal</dt>
            <dd><strong data-guest-cart-subtotal-amount>{view.subtotalText}</strong></dd>
          </div>
        )}
        <div class="guest-checkout-breakdown__row" data-checkout-shipping>
          <dt>Shipping</dt>
          <dd data-checkout-shipping-amount>{shippingText}</dd>
        </div>
        <div class="guest-checkout-breakdown__row" data-checkout-tax>
          <dt>Tax</dt>
          <dd data-checkout-tax-amount>Calculated at checkout</dd>
        </div>
        <div class="guest-checkout-breakdown__row guest-checkout-breakdown__total" data-checkout-total>
          <dt>Estimated total <span class="guest-checkout-breakdown__note">before tax</span></dt>
          <dd><strong data-checkout-total-amount>Calculated at checkout</strong></dd>
        </div>
      </dl>
    </aside>
  </div>
  )}
</section>
<style>
  .guest-checkout{width:min(70rem,calc(100% - 2rem));margin:3rem auto;min-height:65vh;overflow-wrap:anywhere}
  .guest-checkout-header{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin:0 0 1.5rem}
  h1{font-size:clamp(2.5rem,6vw,4.5rem);letter-spacing:-.05em;margin:0}
  .guest-checkout-back{color:inherit;font-weight:800;text-underline-offset:.25em}
  [data-guest-cart-status],[data-guest-cart-empty]{color:var(--store-muted);line-height:1.5;margin:0 0 1.25rem}
  [data-guest-cart-status][role="alert"]{color:var(--store-alert-ink);background:var(--store-alert);padding:.8rem 1rem;border-radius:.6rem}
  .guest-checkout-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(18rem,.85fr);gap:2rem;align-items:start}
  .guest-checkout-vault{background:#172033;color:#f7f4ee;border:2px solid #0f1726;border-radius:.75rem;padding:1.5rem;box-shadow:.35rem .35rem 0 #c83e2b;min-width:0}
  .guest-checkout-vault__header{margin:0 0 1.25rem;padding-bottom:.85rem;border-bottom:1px solid #2d3a54}
  .guest-checkout-vault__eyebrow{margin:0 0 .35rem;font-size:.75rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#f3a69b}
  .guest-checkout-vault__header h2{margin:0;font-size:1.5rem;letter-spacing:-.02em;color:#fffefb}
  .guest-cart-contact{display:grid;gap:.55rem;margin:0 0 1rem;padding:1rem;border:1px solid #2d3a54;border-radius:.6rem;background:#11192a;min-width:0}
  .guest-cart-contact legend{padding:0 .35rem;font-weight:800;color:#fffefb}
  .guest-cart-contact p{margin:0 0 .5rem;color:#c2cad8;line-height:1.45}
  .guest-cart-contact [data-guest-cart-contact-error]{color:var(--store-alert-ink);background:var(--store-alert);padding:.8rem 1rem;border-radius:.25rem;scroll-margin-block:1rem}
  .guest-cart-contact [data-guest-cart-contact-error][hidden]{display:none}
  .guest-cart-contact [aria-invalid="true"]{border:2px solid #b44536;scroll-margin-block:5rem}
  .guest-cart-contact h2{font-size:1.15rem;margin:.75rem 0 0;color:#fffefb}
  .guest-cart-contact label{font-weight:700;color:#f7f4ee}
  .guest-cart-contact span{color:#b8c0cf;font-size:.9em;font-weight:500}
  .guest-cart-contact input,.guest-cart-contact select{width:100%;box-sizing:border-box;padding:.65rem;border:1px solid #3c4c6b;border-radius:.35rem;background:#0b111e;color:#fffefb;font:inherit}
  .guest-cart-contact input:focus-visible,.guest-cart-contact select:focus-visible{outline:3px solid #60a5fa;outline-offset:2px}
  .guest-cart-delivery{display:grid;gap:.55rem;margin-top:.5rem;padding-top:.75rem;border-top:1px solid #2d3a54}
  .guest-cart-delivery[hidden]{display:none}
  .guest-cart-contact .guest-cart-billing-same{display:flex;gap:.5rem;align-items:center;margin-top:.75rem;font-weight:600}
  .guest-cart-contact .guest-cart-billing-same input{width:auto}
  .guest-cart-contact .guest-cart-billing-same[hidden]{display:none}
  .guest-cart-coupon{display:grid;gap:.5rem;margin:0 0 1.25rem;padding:1rem;border:1px dashed #3c4c6b;border-radius:.6rem;color:#b8c0cf;background:#11192a}
  .guest-cart-coupon label{font-weight:700;color:#f7f4ee}
  .guest-cart-coupon input{width:100%;box-sizing:border-box;padding:.6rem;border:1px solid #2d3a54;border-radius:.35rem;background:#0b111e;color:#94a3b8;font:inherit;cursor:not-allowed}
  .guest-cart-coupon p{margin:0;font-size:.9em}
  .guest-cart-coupon input::placeholder{color:#94a3b8;opacity:1}
  .guest-checkout-handoff-note{margin:0 0 .65rem;color:#c2cad8;font-size:.9rem;line-height:1.45}
  .guest-checkout-actions button{margin:.4rem .6rem .4rem 0;padding:.75rem 1.15rem;border:1px solid #3c4c6b;border-radius:.4rem;background:#1e293b;color:#fffefb;font:inherit;font-weight:800;cursor:pointer}
  .guest-checkout-actions [data-guest-cart-checkout]:not(:disabled){background:#c83e2b;border-color:#c83e2b;color:#fffefb}
  .guest-checkout-actions [data-guest-cart-checkout]:disabled{background:#1e293b;border-color:#2d3a54;color:#94a3b8;cursor:not-allowed}
  .guest-checkout-actions [data-guest-cart-checkout-reason]{margin:.5rem 0 0;color:#c2cad8;line-height:1.5}
  .guest-checkout-actions [data-guest-cart-resume]{display:inline-block;margin:.4rem .6rem .4rem 0;padding:.7rem 1rem;border:1px solid #3c4c6b;border-radius:.4rem;background:#11192a;color:#fffefb;font-weight:800;text-decoration:underline;text-underline-offset:.2em}
  .guest-checkout-actions [data-guest-cart-resume][hidden]{display:none}
  .guest-checkout-manifest{padding:1.25rem;border:1.5px solid var(--store-ink-border);border-radius:var(--store-radius-card);background:var(--store-surface);box-shadow:4px 4px 0 var(--store-shadow);min-width:0}
  .guest-checkout-manifest[hidden]{display:none}
  .guest-checkout-manifest__header{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin:0 0 1rem;padding-bottom:.75rem;border-bottom:1px solid var(--store-line)}
  .guest-checkout-manifest__header h2{margin:0;font-size:1.25rem}
  .guest-checkout-manifest__header a{color:inherit;font-size:.9rem;font-weight:700;text-underline-offset:.2em}
  .guest-checkout-manifest__lines{display:grid;gap:.85rem;margin:0 0 1rem}
  .guest-checkout :global([data-guest-cart-line]){display:grid;grid-template-columns:auto minmax(0,1fr);gap:.5rem .85rem;align-items:start;padding:1rem;border:1.5px solid var(--store-ink-border);border-radius:var(--store-radius-card);background:var(--store-surface);box-shadow:3px 3px 0 var(--store-shadow);min-width:0;overflow-wrap:anywhere}
  .guest-checkout :global(.guest-cart-line-media){width:4.5rem;aspect-ratio:4/3;box-sizing:border-box;padding:.25rem;border:1.5px solid var(--store-ink-border);border-radius:.5rem;background:#f7f4ec;overflow:hidden}
  .guest-checkout :global(.guest-cart-line-media img){display:block;width:100%;height:100%;object-fit:cover;border-radius:.3rem;background:#e9e8df}
  .guest-checkout :global([data-guest-cart-thumbnail-placeholder]){display:grid;place-items:center;height:100%;margin:0;border-radius:.3rem;background:#e9e8df;color:var(--store-muted);font-size:.7rem;font-weight:700;text-align:center}
  .guest-checkout :global([data-guest-cart-line-copy]){min-width:0}
  .guest-checkout :global([data-guest-cart-line] h2){font-size:1.1rem;margin:0 0 .4rem}
  .guest-checkout :global([data-guest-cart-line] p){margin:.25rem 0;font-size:.92rem}
  .guest-checkout :global(.price){display:flex;gap:.5rem;flex-wrap:wrap;font-size:1.05rem}
  .guest-checkout :global(s){color:var(--store-muted)}
  .guest-checkout :global([data-guest-cart-line-reason]){color:var(--store-muted);line-height:1.45}
  .guest-checkout :global(.guest-cart-qty){grid-column:1/-1;display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin:.65rem 0;min-width:0}
  .guest-checkout :global([data-guest-cart-qty]){width:4rem;max-width:100%;padding:.35rem .5rem;border:1px solid var(--store-line);border-radius:.35rem;font:inherit;background:var(--store-surface)}
  .guest-checkout :global([data-guest-cart-remove]){grid-column:1/-1;justify-self:start;padding:.45rem .75rem;border:1px solid var(--store-line);border-radius:.35rem;background:var(--store-surface);font:inherit;font-size:.88rem;font-weight:700;cursor:pointer}
  .guest-checkout-breakdown{margin:0;padding-top:.85rem;border-top:1px solid var(--store-line);display:grid;gap:.45rem}
  .guest-checkout-breakdown[hidden]{display:none}
  .guest-checkout-breakdown__row{display:flex;justify-content:space-between;gap:1rem;align-items:baseline}
  .guest-checkout-breakdown__row[hidden]{display:none}
  .guest-checkout-breakdown dt{color:var(--store-muted)}
  .guest-checkout-breakdown dd{margin:0;white-space:nowrap}
  .guest-checkout-breakdown__total{margin-top:.35rem;padding-top:.65rem;border-top:2px solid var(--store-line);font-size:1.15rem}
  .guest-checkout-breakdown__total dt{color:inherit;font-weight:800}
  .guest-checkout-breakdown__note{display:block;color:var(--store-muted);font-size:.8rem;font-weight:500}
  @media(max-width:54rem){
    .guest-checkout-grid{grid-template-columns:1fr}
  }
</style>
<script>
  import { hydrateServerCheckout } from "./checkout-script.ts";
  hydrateServerCheckout();
</script>
