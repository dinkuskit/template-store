---
import type { UnmanagedProductSellability } from "./types.js";

interface Props {
  availability: UnmanagedProductSellability;
}

const { availability } = Astro.props;
const { product, storefront, provenance } = availability;
const statusLabel = {
  "in-stock": "In stock",
  "out-of-stock": "Out of stock",
  "available-on-backorder": "Available on backorder",
  "availability-unavailable": "Availability unavailable",
  "low-stock": "Low stock",
}[storefront.status];
const sellableLabel = storefront.sellable ? "Yes" : "No";
---

<section
  id="unmanaged-product"
  class:list={["unmanaged-product", `unmanaged-product--${storefront.status}`]}
  tabindex="-1"
  aria-labelledby="unmanaged-product-title"
  data-unmanaged-product
  data-availability-status={storefront.status}
  data-sellable={storefront.sellable ? "true" : "false"}
>
  <div class="unmanaged-product__summary">
    <div>
      <p class="unmanaged-product__eyebrow">Current availability</p>
      <h2 id="unmanaged-product-title">{product.name}</h2>
      {availability.price.listable && availability.price.regularText && <p class="unmanaged-product__price" data-product-price>
        {availability.price.saleText ? <><s data-regular-price>{availability.price.regularText}</s> <strong data-sale-price>{availability.price.saleText}</strong></> : <strong data-regular-price>{availability.price.regularText}</strong>}
      </p>}
    </div>
    <p class="unmanaged-product__status" role="status" aria-live="polite">
      <strong data-availability-label>{statusLabel}</strong>
    </p>
  </div>

  <details class="unmanaged-product__details">
    <summary>Product and availability details</summary>
    <p>Commerce owns this product identity and its manual availability. Inventory is not consulted; no quantity is shown for this product.</p>
    <dl class="unmanaged-product__facts">
      <div><dt>Commerce SKU</dt><dd data-unmanaged-sku>{product.sku}</dd></div>
      <div><dt>Stock authority</dt><dd data-stock-mode>{product.stockMode}</dd></div>
      <div><dt>Storefront status</dt><dd data-storefront-status>{storefront.status}</dd></div>
      <div><dt>Sellable</dt><dd data-storefront-sellable data-sellable-label>Sellable: {sellableLabel}</dd></div>
      <div><dt>Quantity shown</dt><dd data-quantity-shown>never</dd></div>
      <div><dt>Commerce state</dt><dd>{product.state}</dd></div>
    </dl>
    <div class="unmanaged-product__provenance">
      <h3>Exact package provenance</h3>
      <dl>
        <div><dt>Blocks</dt><dd><code>{provenance.blocks}</code></dd></div>
        <div><dt>Commerce</dt><dd><code>{provenance.commerce}</code></dd></div>
        <div><dt>Inventory</dt><dd><code>{provenance.inventory}</code></dd></div>
      </dl>
    </div>
  </details>
</section>

<style>
  .unmanaged-product{width:min(70rem,calc(100% - 2rem));margin:1rem auto;padding:clamp(1rem,2.5vw,1.5rem);border:1px solid var(--store-line);border-radius:.85rem;background:var(--store-surface);scroll-margin-top:1rem}
  .unmanaged-product:target{outline:3px solid #215cc8;outline-offset:3px}
  .unmanaged-product__summary{display:flex;align-items:center;justify-content:space-between;gap:1rem}
  .unmanaged-product__eyebrow{margin:0 0 .35rem;color:var(--store-muted);font-size:.72rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .unmanaged-product h2{margin:0;font-size:clamp(1.35rem,3vw,2rem);line-height:1.15}
  .unmanaged-product__status{margin:0;padding:.8rem 1rem;border-radius:.6rem;color:var(--store-stock-ink);background:var(--store-stock)}
  .unmanaged-product__status strong{font-size:clamp(1.1rem,2.5vw,1.45rem);line-height:1.2}
  .unmanaged-product--out-of-stock .unmanaged-product__status,.unmanaged-product--availability-unavailable .unmanaged-product__status{color:var(--store-alert-ink);background:var(--store-alert)}
  .unmanaged-product--available-on-backorder .unmanaged-product__status{color:var(--store-backorder-ink);background:var(--store-backorder)}
  .unmanaged-product__price{display:flex;gap:.5rem;align-items:baseline;flex-wrap:wrap;margin:.6rem 0 0;font-size:1.2rem}
  .unmanaged-product__price s{color:var(--store-muted)}
  .unmanaged-product__details{margin-top:.9rem;border-top:1px solid var(--store-line);padding-top:.75rem}
  .unmanaged-product__details summary{width:fit-content;cursor:pointer;font-weight:700;text-decoration:underline;text-underline-offset:.2em}
  .unmanaged-product__details>p{max-width:55rem;color:var(--store-muted);line-height:1.5}
  .unmanaged-product__facts,.unmanaged-product__provenance dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem;margin:0}
  .unmanaged-product__facts div,.unmanaged-product__provenance dl div{min-width:0}
  .unmanaged-product dt{color:var(--store-muted);font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
  .unmanaged-product dd{margin:.2rem 0 0;overflow-wrap:anywhere;font-weight:650}
  .unmanaged-product__provenance{margin-top:1rem;padding-top:.75rem;border-top:1px solid var(--store-line)}
  .unmanaged-product__provenance h3{margin:0 0 .7rem;font-size:.9rem}
  .unmanaged-product code{font-size:.75rem}
  @media(max-width:44rem){.unmanaged-product__summary{align-items:flex-start;flex-direction:column}.unmanaged-product__facts,.unmanaged-product__provenance dl{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:25rem){.unmanaged-product__facts,.unmanaged-product__provenance dl{grid-template-columns:1fr}}
</style>
