---
import { sanitizeHref } from "emdash";
import type { BlockComponentProps, BlockValue } from "emdash/ui";

type HomeOpenerValue = BlockValue & {
  eyebrow?: string;
  headline?: string;
  deck?: string;
  primary_label?: string;
  primary_href?: string;
  secondary_label?: string;
  secondary_href?: string;
  facts?: Array<{ label?: string; value?: string }>;
};
const { value, index } = Astro.props as BlockComponentProps<HomeOpenerValue>;
const HeadingTag = index === 0 ? "h1" : "h2";
---
<section class="home-opener" data-home-opener>
  {value.eyebrow && <p class="home-opener__eyebrow">{value.eyebrow}</p>}
  <HeadingTag>{value.headline}</HeadingTag>
  {value.deck && <p class="home-opener__deck">{value.deck}</p>}
  <nav class="home-opener__actions" aria-label="Page introduction">
    {value.primary_label && value.primary_href && <a class="home-opener__primary" href={sanitizeHref(value.primary_href)}>{value.primary_label}</a>}
    {value.secondary_label && value.secondary_href && <a href={sanitizeHref(value.secondary_href)}>{value.secondary_label}</a>}
  </nav>
  {value.facts?.length ? <dl class="home-opener__facts" aria-label="Shop facts">
    {value.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
  </dl> : null}
</section>
<style>
  .home-opener{padding:clamp(2rem,7vw,5rem) 0 2rem}.home-opener__eyebrow{margin:0 0 .75rem;color:var(--store-muted);font-size:.76rem;font-weight:800;letter-spacing:.15em;text-transform:uppercase}.home-opener h1,.home-opener h2{max-width:15ch;margin:0;font-size:clamp(2.5rem,7vw,5.5rem);line-height:.98;letter-spacing:-.055em}.home-opener__deck{max-width:48rem;color:var(--store-muted);font-size:1.1rem;line-height:1.65}.home-opener__actions{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;margin:1.5rem 0}.home-opener__actions a{color:inherit;font-weight:800;text-underline-offset:.25em}.home-opener__actions .home-opener__primary{padding:.8rem 1.1rem;border-radius:.4rem;background:var(--dinkus-action-background);color:var(--dinkus-action-color);text-decoration:none}.home-opener__facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:2rem 0 0}.home-opener__facts div{padding:1rem;border-top:1px solid var(--store-line)}.home-opener__facts dt{color:var(--store-muted);font-size:.8rem}.home-opener__facts dd{margin:.25rem 0 0;font-weight:800}@media(max-width:44rem){.home-opener__facts{grid-template-columns:1fr}}
</style>
