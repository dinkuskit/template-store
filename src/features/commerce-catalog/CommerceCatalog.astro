---
import { AddToCart } from "../guest-cart/ui.ts";
import { availabilityLabels, type PublicCommerceProduct } from "./index.js";
import ProductMedia from "./ProductMedia.astro";
import { demoPlaceholderImage } from "../playground/demo-products.js";
import { catalogNoticeText } from "../store-shell/checkout-copy.js";
interface Props {
  products: PublicCommerceProduct[];
  unavailable?: boolean;
  /** Commerce item id -> published EmDash product page path. */
  productPaths?: ReadonlyMap<string, string>;
  /** Installed checkout admission; the footnote stays quiet when checkout works. */
  checkoutAvailable?: boolean;
}
const { products, unavailable = false, productPaths = new Map(), checkoutAvailable = false } = Astro.props;
const notice = catalogNoticeText({ unavailable, productCount: products.length, checkoutAvailable });
---
<section class="shop-catalog" aria-labelledby="commerce-catalog" data-commerce-catalog>
  <h2 id="commerce-catalog">Shop</h2>
  {unavailable ? <p role="alert">The product catalog is temporarily unavailable.</p> : products.length === 0 ? <p data-commerce-empty>No products are listed yet.</p> : <div class="shop-grid">
    {products.map(product => {
      const href = productPaths.get(product.id);
      const body = <>
      <ProductMedia image={product.image} productId={product.id} fallbackSrc={demoPlaceholderImage(product.sku, href?.split("/").pop())} fallbackAlt={`${product.name} placeholder image`} />
      <div class="shop-card__body">
        <h3>{product.name}</h3>
        <div class="shop-card__facts">
          <p class="price">{product.price.saleText ? <><s data-regular-price>{product.price.regularText}</s><strong data-sale-price>{product.price.saleText}</strong></> : <strong data-regular-price>{product.price.regularText}</strong>}</p>
          <p class="availability" data-commerce-availability={product.availability.status}>{availabilityLabels[product.availability.status]}</p>
        </div>
        {!href && <AddToCart product={product} />}
      </div></>;
      // A linked card is one whole link; buying happens on the product page.
      return href
        ? <a class="shop-card shop-card--link" href={href} data-commerce-product={product.id} data-product-link>{body}</a>
        : <article class="shop-card" data-commerce-product={product.id}>{body}</article>;
    })}
  </div>}
  {notice && <p class="notice">{notice}</p>}
</section>
<style>
.shop-catalog{width:min(70rem,calc(100% - 2rem));margin:3rem auto}.shop-catalog h2{font-size:clamp(2.5rem,5vw,4.5rem);letter-spacing:-.05em;margin:0 0 1.5rem}.shop-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}.shop-card{display:flex;min-width:0;overflow:hidden;overflow-wrap:anywhere;flex-direction:column;border:1px solid var(--store-line);border-radius:1rem;background:var(--store-surface);box-shadow:0 .5rem 1.5rem #1720330d}.shop-card--link{text-decoration:none;color:inherit}.shop-card--link:hover h3,.shop-card--link:focus-visible h3{text-decoration:underline}.shop-card--link:focus-visible{outline:3px solid currentColor;outline-offset:2px}.shop-card__body{display:flex;flex:1;flex-direction:column;padding:1.25rem 1.35rem 1.35rem}.shop-card h3{font-size:1.35rem;line-height:1.15;margin:0 0 1rem}.shop-card__facts{display:flex;align-items:baseline;justify-content:space-between;gap:.75rem;flex-wrap:wrap}.shop-card .price{display:flex;gap:.65rem;flex-wrap:wrap;margin:0;font-size:1.25rem}.shop-card .availability{margin:0;color:var(--store-muted);font-weight:700}.shop-card .guest-cart-add{margin-top:auto;padding-top:1rem}a{color:inherit;text-underline-offset:.2em}s,.notice{color:var(--store-muted)}.notice{line-height:1.5}@media(max-width:45rem){.shop-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:34rem){.shop-grid{grid-template-columns:1fr}.shop-card__facts{align-items:flex-start;flex-direction:column;gap:.35rem}}
</style>
