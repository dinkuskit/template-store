---
import { AddToCart } from "../guest-cart/ui.ts";
import { availabilityLabels, type PublicCommerceProduct } from "./index.js";
import ProductMedia from "./ProductMedia.astro";
interface Props { products: PublicCommerceProduct[]; unavailable?: boolean; }
const { products, unavailable = false } = Astro.props;
---
<section class="shop-catalog" aria-labelledby="commerce-catalog" data-commerce-catalog>
  <h2 id="commerce-catalog">Shop</h2>
  {unavailable ? <p role="alert">The product catalog is temporarily unavailable.</p> : products.length === 0 ? <p data-commerce-empty>No products are listed yet.</p> : <div class="shop-grid">
    {products.map(product => <article class="shop-card" data-commerce-product={product.id}>
      <ProductMedia image={product.image} productId={product.id} />
      <div class="shop-card__body">
        <h3>{product.name}</h3>
        <div class="shop-card__facts">
          <p class="price">{product.price.saleText ? <><s data-regular-price>{product.price.regularText}</s><strong data-sale-price>{product.price.saleText}</strong></> : <strong data-regular-price>{product.price.regularText}</strong>}</p>
          <p class="availability" data-commerce-availability={product.availability.status}>{availabilityLabels[product.availability.status]}</p>
        </div>
        <AddToCart product={product} />
      </div>
    </article>)}
  </div>}
  <p class="notice">{unavailable || products.length === 0 ? "Checkout is unavailable." : "Product browsing is available. Checkout is not available yet."}</p>
</section>
<style>
.shop-catalog{width:min(70rem,calc(100% - 2rem));margin:3rem auto}.shop-catalog h2{font-size:clamp(2.5rem,5vw,4.5rem);letter-spacing:-.05em;margin:0 0 1.5rem}.shop-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}.shop-card{display:flex;min-width:0;overflow:hidden;overflow-wrap:anywhere;flex-direction:column;border:1px solid var(--store-line);border-radius:1rem;background:var(--store-surface);box-shadow:0 .5rem 1.5rem #1720330d}.shop-card__body{display:flex;flex:1;flex-direction:column;padding:1.25rem 1.35rem 1.35rem}.shop-card h3{font-size:1.35rem;line-height:1.15;margin:0 0 1rem}.shop-card__facts{display:flex;align-items:baseline;justify-content:space-between;gap:.75rem;flex-wrap:wrap}.shop-card .price{display:flex;gap:.65rem;flex-wrap:wrap;margin:0;font-size:1.25rem}.shop-card .availability{margin:0;color:var(--store-muted);font-weight:700}.shop-card .guest-cart-add{margin-top:auto;padding-top:1rem}a{color:inherit;text-underline-offset:.2em}s,.notice{color:var(--store-muted)}.notice{line-height:1.5}@media(max-width:45rem){.shop-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:34rem){.shop-grid{grid-template-columns:1fr}.shop-card__facts{align-items:flex-start;flex-direction:column;gap:.35rem}}
</style>
