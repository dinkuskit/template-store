---
import { handleMediaGet } from "emdash";
import { getDb } from "emdash/runtime";
import ProductMedia from "./ProductMedia.astro";
import { resolveCommerceImage, type PublicCommerceImage, type ResolvedCommerceImage } from "./media.js";

interface Props {
  image: PublicCommerceImage | null;
  /** Commerce's ordered gallery; the page keeps no second copy (template-rich-product-page-20261027). */
  gallery: readonly PublicCommerceImage[];
  productId: string;
  fallbackSrc?: string | null;
  fallbackAlt?: string;
  /** Classes for the frame holding the first picture. */
  stageClass?: string;
}

const { image, gallery, productId, fallbackSrc = null, fallbackAlt = "", stageClass = "" } = Astro.props;
const emdash = Astro.locals.emdash as { getPublicMediaUrl?: (storageKey: string) => string } | undefined;
const resolver = {
  origin: Astro.url.origin,
  getPublicMediaUrl: emdash?.getPublicMediaUrl,
  async getMedia(id: string) {
    const result = await handleMediaGet(await getDb(), id);
    const item = result.success ? result.data?.item : null;
    if (!item?.storageKey || !item.mimeType) return null;
    return { mimeType: item.mimeType, storageKey: item.storageKey, status: item.status };
  },
};
// The primary picture first, then Commerce's gallery, each once; omit unservable media.
const pictures = (await Promise.all([image, ...gallery].filter((entry): entry is PublicCommerceImage => Boolean(entry))
  .filter((entry, index, all) => all.findIndex((other) => other.id === entry.id) === index)
  .map((entry) => resolveCommerceImage(entry, resolver))))
  .filter((entry): entry is ResolvedCommerceImage => Boolean(entry));
const first = pictures[0] ?? null;
const multiple = pictures.length > 1;
---
<div class:list={["product-gallery", { "product-gallery--multiple": multiple }]} data-product-gallery={productId}
  role={multiple ? "region" : undefined} aria-label={multiple ? "Product pictures" : undefined} tabindex={multiple ? 0 : undefined}>
  <div class={stageClass} data-product-stage-visual>
    <ProductMedia image={first ?? image} productId={productId} fallbackSrc={fallbackSrc} fallbackAlt={fallbackAlt} priority />
  </div>
  {multiple && (
    <div class="product-gallery__extras" data-gallery-extras>
      {pictures.slice(1).map((picture) => (
        <figure class="product-gallery__picture">
          <img src={picture.src} srcset={picture.srcset} sizes="(max-width: 48rem) 85vw, 25vw" alt={picture.alt}
            width={picture.width ?? 640} height={picture.height ?? 480} loading="lazy" decoding="async" data-gallery-picture />
        </figure>
      ))}
    </div>
  )}
</div>
<style>
  .product-gallery { display: grid; gap: .75rem; min-width: 0; }
  .product-gallery__extras { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .product-gallery__picture { margin: 0; min-width: 0; }
  .product-gallery__picture img { display: block; width: 100%; height: auto; border-radius: var(--store-radius-card); }
  .product-gallery:focus-visible { outline: 2px solid var(--store-accent); outline-offset: 4px; }
  @media (max-width: 48rem) {
    .product-gallery--multiple { display: flex; align-items: flex-start; overflow-x: auto; scroll-snap-type: x mandatory; gap: .75rem; padding-bottom: .75rem; scrollbar-color: var(--store-accent) var(--store-surface); }
    .product-gallery--multiple > [data-product-stage-visual],
    .product-gallery__picture { flex: 0 0 88%; scroll-snap-align: start; min-width: 0; }
    .product-gallery__extras { display: contents; }
  }
</style>
