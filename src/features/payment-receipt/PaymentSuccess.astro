---
import type { PaymentReceipt, PaymentReceiptResult } from "./index.ts";

const { result, contactHref } = Astro.props as {
  result: PaymentReceiptResult;
  contactHref: string;
};

const money = (cents: number, currency: string) =>
  new Intl.NumberFormat("en-US", { style: "currency", currency }).format(cents / 100);
const receipt: PaymentReceipt | null = result.kind === "paid" ? result.receipt : null;
---
<section class="payment-success" data-payment-success aria-labelledby="payment-success-title">
  {result.kind === "paid" && receipt ? (
    <>
      <p class="payment-success__eyebrow">Thank you for your order</p>
      <div class="payment-success__heading">
        <h1 id="payment-success-title">Order #{receipt.orderNumber}</h1>
        {receipt.test && <span class="payment-success__badge">TEST</span>}
      </div>
      <p class="payment-success__lead" role="status">
        Your order is confirmed. A confirmation email is coming to {receipt.email}.
      </p>

      <div class="payment-success__grid">
        <div>
          <h2>Items</h2>
          <ul class="payment-success__items">
            {receipt.items.map((item) => (
              <li>
                <span>
                  <strong>{item.name}</strong>
                  {item.variant && <small>{item.variant}</small>}
                  <span>Qty {item.quantity}</span>
                </span>
                <span>{money(item.totalCents, receipt.currency)}</span>
              </li>
            ))}
          </ul>
          <dl class="payment-success__totals">
            <div><dt>Subtotal</dt><dd>{money(receipt.subtotalCents, receipt.currency)}</dd></div>
            <div><dt>Shipping</dt><dd>{money(receipt.shippingCents, receipt.currency)}</dd></div>
            <div><dt>Tax</dt><dd>{money(receipt.taxCents, receipt.currency)}</dd></div>
            <div class="payment-success__total"><dt>Total</dt><dd>{money(receipt.totalCents, receipt.currency)}</dd></div>
          </dl>
        </div>

        <div>
          <h2>Ship to</h2>
          <address>
            {receipt.shipTo.name}<br />
            {receipt.shipTo.line1}<br />
            {receipt.shipTo.line2 && <>{receipt.shipTo.line2}<br /></>}
            {receipt.shipTo.city}, {receipt.shipTo.state} {receipt.shipTo.postalCode}<br />
            {receipt.shipTo.country}
          </address>
          <h2>What happens next</h2>
          <p>A confirmation email is coming now. When your order ships, we&rsquo;ll send a shipping email with tracking.</p>
          <p>Questions? <a href={contactHref}>Contact the store</a>.</p>
        </div>
      </div>
    </>
  ) : result.kind === "pending" ? (
    <>
      <h1 id="payment-success-title">Your payment is processing</h1>
      <p class="payment-success__lead" role="status">
        We&rsquo;re still confirming your payment. Please refresh shortly.
      </p>
      <p><a href="/checkout/success">Refresh the order status</a> or <a href={contactHref}>contact the store</a>.</p>
    </>
  ) : (
    <>
      <h1 id="payment-success-title">We couldn&rsquo;t find that order</h1>
      <p class="payment-success__lead" role="alert">
        We couldn&rsquo;t confirm this order. Please check your confirmation link or <a href={contactHref}>contact the store</a>.
      </p>
    </>
  )}
</section>
<style>
  .payment-success{width:min(64rem,calc(100% - 2rem));margin:4rem auto 6rem}
  .payment-success__eyebrow{margin:0;color:var(--store-muted);font-weight:800;text-transform:uppercase;letter-spacing:.08em;font-size:.8rem}
  .payment-success h1{margin:.35rem 0;font-size:clamp(2.25rem,6vw,4.5rem);letter-spacing:-.06em}
  .payment-success h2{margin:2rem 0 .75rem;font-size:1.1rem}
  .payment-success__heading{display:flex;align-items:center;gap:.8rem;flex-wrap:wrap}
  .payment-success__badge{padding:.25rem .5rem;border-radius:.35rem;background:#f8ecd3;color:#6b3f08;font-size:.8rem;font-weight:900;letter-spacing:.08em}
  .payment-success__lead,.payment-success p{max-width:48rem;color:var(--store-muted);line-height:1.6}
  .payment-success__grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(16rem,1fr);gap:3rem;margin-top:2rem}
  .payment-success__items{list-style:none;margin:0;padding:0;border-top:1px solid var(--store-line)}
  .payment-success__items li{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--store-line)}
  .payment-success__items li>span:first-child{display:grid;gap:.2rem}
  .payment-success__items small,.payment-success__items li>span:first-child>span{color:var(--store-muted)}
  .payment-success__totals{margin:1.25rem 0 0}
  .payment-success__totals div{display:flex;justify-content:space-between;gap:1rem;padding:.35rem 0}
  .payment-success__totals dt{color:var(--store-muted)}
  .payment-success__totals dd{margin:0}
  .payment-success__totals .payment-success__total{margin-top:.5rem;padding-top:.75rem;border-top:2px solid var(--store-line);font-weight:900;font-size:1.1rem}
  .payment-success address{font-style:normal;line-height:1.7;color:var(--store-muted)}
  .payment-success a{color:inherit;font-weight:800;text-underline-offset:.2em}
  @media (max-width:44rem){.payment-success{margin-top:2.5rem}.payment-success__grid{grid-template-columns:1fr;gap:0}}
</style>
