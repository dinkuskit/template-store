---
import { getEmDashCollection } from "emdash";
import { readCommerceCatalog, availabilityLabels } from "../../features/commerce-catalog/index.js";
import ProductMedia from "../../features/commerce-catalog/ProductMedia.astro";
import { AddToCart, GuestCartNav } from "../../features/guest-cart/ui.ts";
import { STORE_TITLE, readStorefrontProfile } from "../../features/store-shell/index.js";
import "../../features/store-shell/global.css";
import { canonicalProductPath, validProductSlug } from "../../features/store-shell/product-routes.js";
const productEntries = await getEmDashCollection<"products", Record<string, unknown>>("products", { status: "published" });
const linked = productEntries.entries.find((entry) =>
  entry.data.commerceItemId === Astro.params.id && validProductSlug(entry.id),
);
if (linked) {
  const target = new URL(canonicalProductPath(linked.id), Astro.url);
  return new Response(null, {
    status: 302,
    headers: { Location: target.href, "Cache-Control": "no-store" },
  });
}
let unavailable = false;
const catalogProducts = await readCommerceCatalog({ runtime: Astro.locals.emdash, request: Astro.request }).catch(() => { unavailable = true; return []; });
const product = catalogProducts.find(item => item.id === Astro.params.id);
if (unavailable) Astro.response.status = 503;
else if (!product) Astro.response.status = 404;
const profile = readStorefrontProfile();
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{product?.name ?? "Product unavailable"} | {STORE_TITLE}</title></head>
<body data-storefront-profile={profile}>
<div class="store-demo-banner" data-store-demo-banner role="status">Demo / Test Store &mdash; Synthetic demonstration. Purchases and checkout are unavailable.</div>
<header class="store-header"><a class="store-header__mark" href="/">DinkusKit / Store</a><nav class="store-header__nav" aria-label="Store"><GuestCartNav /></nav></header>
<main class="shop-detail">
<a href="/#commerce-catalog">← Back to shop</a>
{product ? <article data-commerce-product={product.id}>
<ProductMedia image={product.image} productId={product.id} />
<h1>{product.name}</h1>
<p>SKU: {product.sku}</p>
<p class="price">{product.price.saleText ? <><s data-regular-price>{product.price.regularText}</s><strong data-sale-price>{product.price.saleText}</strong></> : <strong data-regular-price>{product.price.regularText}</strong>}</p>
<p data-commerce-availability={product.availability.status}>{availabilityLabels[product.availability.status]}</p>
<AddToCart product={product} />
<p>Checkout is not available yet.</p>
</article> : <><h1>{unavailable ? "Catalog temporarily unavailable" : "Product not found"}</h1><p>{unavailable ? "Please try again later." : "This product is not publicly listed."}</p></>}
</main>
</body>
</html>
<style>
.shop-detail{width:min(70rem,calc(100% - 2rem));margin:3rem auto;min-height:65vh;overflow-wrap:anywhere}h1{font-size:clamp(2.5rem,6vw,5rem);letter-spacing:-.05em}.price{display:flex;gap:.75rem;flex-wrap:wrap;font-size:1.75rem}s{color:var(--store-muted)}a{color:inherit;text-underline-offset:.2em}
</style>
