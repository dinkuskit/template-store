---
import StoreFooter from "../features/store-shell/StoreFooter.astro";
import StoreHeader from "../features/store-shell/StoreHeader.astro";
import { ReviewForm } from "../features/review-form/ui.ts";
import { openReviewPage, reviewPageStatus, sendReviewForm } from "../features/review-form/index.js";
import { acquireGuestCheckoutAdmission } from "../features/guest-cart/checkout-admission.js";
import { STORE_TITLE, readStorefrontProfile } from "../features/store-shell/index.js";
import { playgroundCheckoutAdmission } from "../features/playground-checkout/index.js";
import { playgroundCheckoutConfigured, playgroundEnvOf } from "../features/playground-checkout/payments-port.js";
import { storeBannerText } from "../features/store-shell/checkout-copy.js";
import "../features/store-shell/global.css";

const profile = readStorefrontProfile();
Astro.response.headers.set("Cache-Control", "no-store");
// The link's secret is in this page's address, so the page never passes its address on.
Astro.response.headers.set("Referrer-Policy", "no-referrer");
const checkoutAdmission = await acquireGuestCheckoutAdmission({
  runtime: Astro.locals.emdash,
  request: Astro.request,
}).catch(() => null);
const isPlayground = Boolean((Astro.locals as { __playgroundDb?: unknown }).__playgroundDb);
const playgroundAdmission = playgroundCheckoutAdmission(isPlayground, playgroundCheckoutConfigured(playgroundEnvOf(Astro.locals)));
const effectiveAdmission = playgroundAdmission ?? checkoutAdmission;
// The buyer's review page (dinkuskit/reviews, reviews-review-page-on-store-20261122): Reviews answers what the
// emailed link opens and keeps the review; a store without Reviews answers every link as one that does not work.
const page = { locals: Astro.locals, request: Astro.request, url: Astro.url };
const view = Astro.request.method === "POST" ? await sendReviewForm(page) : await openReviewPage(page);
Astro.response.status = reviewPageStatus(view);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>{view.kind === "form" ? `Review ${view.productName}` : view.kind === "stop" || view.kind === "stopped" ? "Stop review emails" : "Write a review"} | {STORE_TITLE}</title>
  </head>
  <body data-storefront-profile={profile}>
    <div class="store-demo-banner" data-store-demo-banner data-checkout-available={String(Boolean(effectiveAdmission))} role="status">{storeBannerText(Boolean(effectiveAdmission))}</div>
    <StoreHeader profile={profile} />
    <main>
      <ReviewForm view={view} />
    </main>
    <StoreFooter profile={profile} />
  </body>
</html>
