---
import { getEmDashEntry, getEmDashCollection, getMenu, type PortableTextBlock } from "emdash";
import { Blocks, PortableText, type BlockValue } from "emdash/ui";
import { pageLayoutComponents } from "../features/store-shell/blocks/index.js";
import { legacyPortableTextComponents } from "../features/store-shell/portable-text/index.js";
import UnknownBlock from "../features/store-shell/blocks/UnknownBlock.astro";

import CommerceCatalog from "../features/commerce-catalog/CommerceCatalog.astro";
import { readCommerceCatalog } from "../features/commerce-catalog/index.js";
import { GuestCartNav } from "../features/guest-cart/ui.ts";
import MerchCatalog from "../features/store-shell/MerchCatalog.astro";
import ManagedProductAvailability from "../features/managed-product-availability/ManagedProductAvailability.astro";
import UnmanagedProductSellability from "../features/unmanaged-product-sellability/UnmanagedProductSellability.astro";
import {
  STORE_DESCRIPTION,
  STORE_TITLE,
  loadStorefrontRouteContext,
} from "../features/store-shell/index.js";
import { hydrateProductCollectionMembership, readProductEntries } from "../features/store-shell/product-routes.js";
import "../features/store-shell/global.css";

const { entry: page } = await getEmDashEntry("pages", "home");
const pageData = page ? page.data as (typeof page.data & { layout?: BlockValue[] }) : undefined;
const layout = pageData?.layout;
const content = pageData?.content as PortableTextBlock[] | undefined;
const productCollection = await getEmDashCollection<"products", Record<string, unknown>>("products", { status: "published" });
const products = { ...productCollection, entries: await hydrateProductCollectionMembership(productCollection.entries) };
const categoryEntries = await getEmDashCollection<"categories", Record<string, unknown>>("categories", { status: "published" });
const storeMenu = await getMenu("store-primary");
const productLinks = readProductEntries(products.entries, categoryEntries.entries);
if (productLinks.errors.length > 0) {
  console.error(`[product-url] excluded published product entries: ${productLinks.errors.join("; ")}`);
}
const { profile, demonstrations, collections } = await loadStorefrontRouteContext(
  products.entries.filter((entry) => productLinks.products.some((product) => product.id === entry.id)),
  categoryEntries.entries,
);
let catalogUnavailable = false;
const commerceProducts = await readCommerceCatalog({ runtime: Astro.locals.emdash, request: Astro.request }).catch(() => { catalogUnavailable = true; return []; });
const availability = demonstrations?.managed;
const unmanaged = demonstrations?.unmanaged;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={STORE_DESCRIPTION} />
    <title>{STORE_TITLE}</title>
  </head>
  <body data-storefront-profile={profile}>
    <div class="store-demo-banner" data-store-demo-banner role="status">Demo / Test Store &mdash; Synthetic demonstration. Purchases and checkout are unavailable.</div>
    <header class="store-header">
      <a class="store-header__mark" href="/">DinkusKit / Store</a>
      <nav class="store-header__nav" aria-label="Store">
        <span class="store-header__status">Local integration proof</span>
        <GuestCartNav />
      </nav>
    </header>
    <main>
      {
        layout?.length ? (
          <div class="cms-composition" data-cms-composition data-layout="blocks">
            <Blocks
              value={layout}
              components={pageLayoutComponents}
              fallback={UnknownBlock}
            />
          </div>
        ) : content?.length ? (
          <div class="cms-composition" data-cms-composition data-layout="portable-text">
            <PortableText value={content} components={legacyPortableTextComponents} />
          </div>
        ) : (
          <section class="store-error" role="alert" data-content-missing>
            <h1>Storefront composition is unavailable</h1>
            <p>Load the neutral EmDash seed before presenting this starter.</p>
          </section>
        )
      }
      <CommerceCatalog products={commerceProducts} unavailable={catalogUnavailable} />
      {demonstrations && availability && unmanaged && (
      <section aria-label="Separate integration demonstrations" data-integration-demos>
      <h2 class="demo-heading">Integration demonstrations</h2>
      <p class="demo-heading">These seeded examples are separate from the merchant catalog above.</p>
      <MerchCatalog collections={collections} menu={storeMenu ?? undefined} managed={availability} unmanaged={unmanaged} />
      {availability.price.listable && <ManagedProductAvailability availability={availability} />}
      {unmanaged.price.listable && <UnmanagedProductSellability availability={unmanaged} />}
      </section>
      )}
      {productLinks.errors.length > 0 && (
        <aside data-product-url-errors hidden>{productLinks.errors.join(" | ")}</aside>
      )}
    </main>
    <footer class="store-footer">
      Transactional facts remain in Commerce{profile === "proof" ? " and Inventory" : ""}; EmDash owns the
      surrounding composition.
    </footer>
  </body>
</html>
