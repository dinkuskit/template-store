---
import StoreFooter from "../features/store-shell/StoreFooter.astro";
import StoreHeader from "../features/store-shell/StoreHeader.astro";
import { getEmDashEntry, getEmDashCollection, getSiteSettings, type PortableTextBlock } from "emdash";
import { Blocks, PortableText, type BlockValue } from "emdash/ui";
import { pageLayoutComponents } from "../features/store-shell/blocks/index.js";
import { legacyPortableTextComponents } from "../features/store-shell/portable-text/index.js";
import UnknownBlock from "../features/store-shell/blocks/UnknownBlock.astro";

import CommerceCatalog from "../features/commerce-catalog/CommerceCatalog.astro";
import { readCommerceCatalog } from "../features/commerce-catalog/index.js";
import { acquireGuestCheckoutAdmission } from "../features/guest-cart/checkout-admission.js";
import { playgroundCheckoutAdmission, playgroundCheckoutConfigured } from "../features/playground-checkout/index.js";
import {
  STORE_DESCRIPTION,
  STORE_TITLE,
  readStorefrontProfile,
} from "../features/store-shell/index.js";
import { catalogGuidanceCopy, storeBannerText } from "../features/store-shell/checkout-copy.js";
import { canonicalProductPath, commercePageLinks, hydrateProductCollectionMembership, readProductEntries } from "../features/store-shell/product-routes.js";
import "../features/store-shell/global.css";

const { entry: page } = await getEmDashEntry("pages", "home");
const pageData = page ? page.data as (typeof page.data & { layout?: BlockValue[] }) : undefined;
const layout = pageData?.layout;
const content = pageData?.content as PortableTextBlock[] | undefined;
const productCollection = await getEmDashCollection<"products", Record<string, unknown>>("products", { status: "published" });
const products = { ...productCollection, entries: await hydrateProductCollectionMembership(productCollection.entries) };
const categoryEntries = await getEmDashCollection<"categories", Record<string, unknown>>("categories", { status: "published" });
const profile = readStorefrontProfile();
let catalogUnavailable = false;
const commerceProducts = await readCommerceCatalog({ runtime: Astro.locals.emdash, request: Astro.request }).catch(() => { catalogUnavailable = true; return []; });
// Commerce keeps which page sells each product (template-no-commerce-box-20261029).
const productLinks = readProductEntries(products.entries, categoryEntries.entries, commercePageLinks(commerceProducts));
if (productLinks.errors.length > 0) {
  console.error(`[product-url] excluded published product entries: ${productLinks.errors.join("; ")}`);
}
const productPaths = new Map(productLinks.products.map((product) => [product.commerceItemId, canonicalProductPath(product.slug)]));
const isPlayground = Boolean((Astro.locals as { __playgroundDb?: unknown }).__playgroundDb);
// A configured playground admits its sandbox checkout, as the cart page does.
const checkoutAvailable = Boolean(playgroundCheckoutAdmission(isPlayground, playgroundCheckoutConfigured())) ||
  Boolean(await acquireGuestCheckoutAdmission({
    runtime: Astro.locals.emdash,
    request: Astro.request,
  }).catch(() => null));
const guidanceState = catalogUnavailable ? "unavailable" : commerceProducts.length === 0 ? "empty" : "ready";
const guidance = catalogGuidanceCopy(guidanceState, checkoutAvailable);
// A store with no published "home" page still greets shoppers with its name
// and the shop; the seed hint is for developers only.
const composed = Boolean(layout?.length || content?.length);
const siteSettings = composed ? null : await getSiteSettings().catch(() => null);
const siteTitle = siteSettings?.title?.trim() || STORE_TITLE;
const siteTagline = siteSettings?.tagline?.trim() || null;
if (!composed && import.meta.env.DEV) {
  console.warn('[storefront] No published page with slug "home"; showing the default storefront. Load the neutral EmDash seed or publish a home page.');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={STORE_DESCRIPTION} />
    <title>{STORE_TITLE}</title>
  </head>
  <body data-storefront-profile={profile}>
    <div class="store-demo-banner" data-store-demo-banner data-checkout-available={String(checkoutAvailable)} role="status">{storeBannerText(checkoutAvailable)}</div>
    <StoreHeader profile={profile} />
    <main>
      {
        layout?.length ? (
          <div class="cms-composition" data-cms-composition data-layout="blocks">
            <Blocks
              value={layout}
              components={pageLayoutComponents}
              fallback={UnknownBlock}
            />
          </div>
        ) : content?.length ? (
          <div class="cms-composition" data-cms-composition data-layout="portable-text">
            <PortableText value={content} components={legacyPortableTextComponents} />
          </div>
        ) : (
          <section class="store-default-home" data-home-default>
            <h1>{siteTitle}</h1>
            {siteTagline && <p>{siteTagline}</p>}
            <a href="#commerce-catalog">Browse the shop</a>
          </section>
        )
      }
      <section class="catalog-guidance" data-catalog-guidance data-catalog-guidance-state={guidanceState} aria-label="How to use this store">
        <strong>{guidance.heading}</strong>
        <p>{guidance.detail}</p>
      </section>
      <CommerceCatalog products={commerceProducts} unavailable={catalogUnavailable} productPaths={productPaths} checkoutAvailable={checkoutAvailable} />
      {productLinks.errors.length > 0 && (
        <aside data-product-url-errors hidden>{productLinks.errors.join(" | ")}</aside>
      )}
    </main>
    <StoreFooter profile={profile} />
  </body>
</html>
