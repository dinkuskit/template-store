---
import StoreFooter from "../features/store-shell/StoreFooter.astro";
import StoreHeader from "../features/store-shell/StoreHeader.astro";
import { ShopperAccount } from "../features/shopper-account/ui.ts";
import { acquireGuestCheckoutAdmission } from "../features/guest-cart/checkout-admission.js";
import { STORE_TITLE, readStorefrontProfile } from "../features/store-shell/index.js";
import { playgroundCheckoutAdmission } from "../features/playground-checkout/index.js";
import { playgroundCheckoutConfigured } from "../features/playground-checkout/payments-port.js";
import { storeBannerText } from "../features/store-shell/checkout-copy.js";
import {
  isPlaygroundPreviewHost,
  resolvePlaygroundAccountSiteOrigin,
} from "../features/shopper-account/playground-runtime.js";
import "../features/store-shell/global.css";

const profile = readStorefrontProfile();
Astro.response.headers.set("Cache-Control", "no-store");
const checkoutAdmission = await acquireGuestCheckoutAdmission({
  runtime: Astro.locals.emdash,
  request: Astro.request,
}).catch(() => null);
const isPlayground = Boolean((Astro.locals as { __playgroundDb?: unknown }).__playgroundDb);
const playgroundAdmission = playgroundCheckoutAdmission(isPlayground, playgroundCheckoutConfigured());
const effectiveAdmission = playgroundAdmission ?? checkoutAdmission;
// The instant demo account and captured-PIN sign-in are the playground's (shopper-accounts-playground-20261020);
// a store running Commerce's Registry build signs shoppers in through the installed plugin itself.
const playgroundMode = isPlayground;
const playgroundAccountOrigin = resolvePlaygroundAccountSiteOrigin();
const previewUnavailable = isPlayground && isPlaygroundPreviewHost(Astro.url, playgroundAccountOrigin);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Account | {STORE_TITLE}</title>
  </head>
  <body data-storefront-profile={profile}>
    <div class="store-demo-banner" data-store-demo-banner data-checkout-available={String(Boolean(effectiveAdmission))} role="status">{storeBannerText(Boolean(effectiveAdmission))}</div>
    <StoreHeader profile={profile} />
    <main>
      <ShopperAccount
        playgroundMode={playgroundMode}
        previewUnavailableOrigin={previewUnavailable ? playgroundAccountOrigin : undefined}
      />
    </main>
    <StoreFooter profile={profile} />
  </body>
</html>
