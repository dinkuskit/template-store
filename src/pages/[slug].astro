---
/**
 * Any published CMS page at its own address, such as /about-us
 * (template-cms-pages-and-redirects-20261027). Pages with their own storefront
 * file (/shipping, /returns, the home page) keep it; Astro serves those first.
 */
import { getEmDashEntry, type PortableTextBlock } from "emdash";
import { Blocks, PortableText, type BlockValue } from "emdash/ui";
import StoreHeader from "../features/store-shell/StoreHeader.astro";
import StoreFooter from "../features/store-shell/StoreFooter.astro";
import UnknownBlock from "../features/store-shell/blocks/UnknownBlock.astro";
import { pageLayoutComponents } from "../features/store-shell/blocks/index.js";
import { legacyPortableTextComponents } from "../features/store-shell/portable-text/index.js";
import { STORE_TITLE, readStorefrontProfile } from "../features/store-shell/index.js";
import { canonicalUrl } from "../features/store-shell/structured-data.js";
import "../features/store-shell/global.css";

const slug = Astro.params.slug ?? "";
// The home page lives at "/", never at "/home".
const { entry } = slug === "home" ? { entry: null } : await getEmDashEntry("pages", slug);
const data = entry?.data as { title?: string; content?: PortableTextBlock[]; layout?: BlockValue[] } | undefined;
const layout = Array.isArray(data?.layout) ? data.layout : [];
const content = Array.isArray(data?.content) ? data.content : [];
const title = data?.title?.trim() || "Page not found";
const profile = readStorefrontProfile();
if (!entry) Astro.response.status = 404;
const canonical = entry ? canonicalUrl(`/${slug}`, Astro.site, Astro.url) : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {canonical && <link rel="canonical" href={canonical} />}
    {!entry && <meta name="robots" content="noindex" />}
    <title>{title} | {STORE_TITLE}</title>
  </head>
  <body data-storefront-profile={profile}>
    <StoreHeader profile={profile} />
    <main class="cms-page" data-cms-page={entry ? slug : undefined}>
      {entry ? (
        <>
          {layout.length === 0 && <h1 class="cms-page__title">{title}</h1>}
          {layout.length > 0 ? (
            <div class="cms-composition" data-cms-composition data-layout="blocks">
              <Blocks value={layout} components={pageLayoutComponents} fallback={UnknownBlock} />
            </div>
          ) : content.length > 0 && (
            <div class="cms-page__body prose" data-cms-page-body>
              <PortableText value={content} components={legacyPortableTextComponents} />
            </div>
          )}
        </>
      ) : (
        <section class="cms-page__missing" data-page-not-found>
          <h1 class="cms-page__title">Page not found</h1>
          <p>There is no page at this address.</p>
          <a href="/">Back to the store</a>
        </section>
      )}
    </main>
    <StoreFooter profile={profile} />
  </body>
</html>
<style>
  .cms-page{width:min(70rem,calc(100% - 2rem));margin:2.5rem auto 4rem;min-height:60vh;line-height:1.65}
  .cms-page .cms-composition{width:100%}
  .cms-page__title{margin:0 0 1rem;font-size:clamp(2.1rem,5vw,3.4rem);line-height:1.02;letter-spacing:-.045em}
  .cms-page__body{max-width:44rem}
  .cms-page__body :global(h2){margin:1.5rem 0 .5rem;font-size:1.3rem;letter-spacing:-.02em}
  .cms-page__body :global(p){margin:0 0 1rem;color:var(--store-ink)}
  .cms-page__missing a{font-weight:700;color:var(--store-ink)}
</style>
