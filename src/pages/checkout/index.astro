---
import StoreFooter from "../../features/store-shell/StoreFooter.astro";
import StoreHeader from "../../features/store-shell/StoreHeader.astro";
import { GuestCheckout } from "../../features/guest-cart/ui.ts";
import { acquireGuestCheckoutAdmission } from "../../features/guest-cart/checkout-admission.js";
import { COMMERCE_REGISTRY_RUNTIME_ID } from "../../features/guest-cart/checkout-protocol.js";
import { readInstalledCommercePolicies } from "../../features/commerce-policies/index.js";
import { STORE_TITLE, readStorefrontProfile } from "../../features/store-shell/index.js";
import SandboxCheckoutNotice from "../../features/playground-checkout/SandboxCheckoutNotice.astro";
import { isCheckoutEnabled, playgroundCheckoutAdmission, showsSandboxCheckoutNotice } from "../../features/playground-checkout/index.js";
import { playgroundCheckoutConfigured, playgroundEnvOf } from "../../features/playground-checkout/payments-port.js";
import { isDemoCatalogProfile } from "../../features/playground/demo-products.js";
import { PLAYGROUND_FLAT_RATE_SHIPPING } from "../../features/playground/flat-rate-shipping.js";
import { storeBannerText } from "../../features/store-shell/checkout-copy.js";
import "../../features/store-shell/global.css";

const profile = readStorefrontProfile();
Astro.response.headers.set("Cache-Control", "no-store");
const checkoutAdmission = await acquireGuestCheckoutAdmission({
  runtime: Astro.locals.emdash,
  request: Astro.request,
}).catch(() => null);
const isPlayground = Boolean((Astro.locals as { __playgroundDb?: unknown }).__playgroundDb);
const gate = { profile, isPlayground, isDemo: isDemoCatalogProfile(), checkoutEnabled: isCheckoutEnabled() };
const sandboxCheckout = showsSandboxCheckoutNotice(gate);
// Only a configured playground session admits checkout; everything else stays closed.
const playgroundAdmission = playgroundCheckoutAdmission(isPlayground, playgroundCheckoutConfigured(playgroundEnvOf(Astro.locals)));
const effectiveAdmission = playgroundAdmission ?? checkoutAdmission;
const installedPolicies = isPlayground
  ? null
  : await readInstalledCommercePolicies(
      { runtime: Astro.locals.emdash, request: Astro.request },
      COMMERCE_REGISTRY_RUNTIME_ID,
    ).catch(() => null);
const shipping = isPlayground ? PLAYGROUND_FLAT_RATE_SHIPPING : installedPolicies?.shipping ?? null;
const shippingMode = shipping?.mode === "flat" || shipping?.mode === "free" ? shipping.mode : null;
const shippingMinor = shipping?.amount?.minor ?? null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Checkout | {STORE_TITLE}</title>
  </head>
  <body data-storefront-profile={profile}>
    <div class="store-demo-banner" data-store-demo-banner data-checkout-available={String(Boolean(effectiveAdmission))} role="status">{storeBannerText(Boolean(effectiveAdmission))}</div>
    <StoreHeader profile={profile} />
    <main>
      {sandboxCheckout && <SandboxCheckoutNotice />}
      <GuestCheckout
        checkoutAdmission={playgroundAdmission ?? (isPlayground ? undefined : checkoutAdmission ?? undefined)}
        shippingMode={shippingMode}
        shippingMinor={shippingMinor}
      />
    </main>
    <StoreFooter profile={profile} />
  </body>
</html>
