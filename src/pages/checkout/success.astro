---
import { getSiteSettings } from "emdash";
import { GuestCartNav, GuestCheckoutReturn } from "../../features/guest-cart/ui.ts";
import { STORE_TITLE, readStorefrontProfile } from "../../features/store-shell/index.js";
import { formatReceiptTotal, isCheckoutEnabled, SANDBOX_CLIENT_IP_MESSAGE, SANDBOX_RATE_LIMITED_MESSAGE, lookupCheckoutReceipt, readPaymentsConfig, SANDBOX_SESSION_NOTICE, showsSandboxCheckoutNotice } from "../../features/playground-checkout/index.js";
import { isDemoCatalogProfile } from "../../features/playground/demo-products.js";
import "../../features/store-shell/global.css";

const profile = readStorefrontProfile();
const settings = await getSiteSettings().catch(() => ({}));
const rawSettings = settings as typeof settings & {
  contactEmail?: unknown;
  contactUrl?: unknown;
};
const contactHref = (() => {
  if (typeof rawSettings.contactEmail === "string" && rawSettings.contactEmail.includes("@")) {
    return `mailto:${rawSettings.contactEmail}`;
  }
  if (typeof rawSettings.contactUrl === "string") {
    try {
      const url = new URL(rawSettings.contactUrl);
      if (url.protocol === "https:" || url.protocol === "http:") return url.href;
    } catch {}
  }
  return undefined;
})();
Astro.response.headers.set("Cache-Control", "no-store");
const isPlayground = Boolean((Astro.locals as { __playgroundDb?: unknown }).__playgroundDb);
const sandboxCheckout = showsSandboxCheckoutNotice({ profile, isPlayground, isDemo: isDemoCatalogProfile(), checkoutEnabled: isCheckoutEnabled() });
// Lookup-only: the sandbox success page asks Payments for this session's receipt
// server-side. No wakes are read or acked for the playground tenant.
const receipt = sandboxCheckout
  ? await lookupCheckoutReceipt({ sessionId: Astro.url.searchParams.get("session_id"), config: readPaymentsConfig(), request: Astro.request })
  : null;
const receiptTotal = formatReceiptTotal(receipt?.total);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Order confirmation | {STORE_TITLE}</title>
  </head>
  <body data-storefront-profile={profile}>
    <div class="store-demo-banner" data-store-demo-banner role="status">Demo checkout &mdash; No real payments or fulfillment.</div>
    <header class="store-header">
      <a class="store-header__mark" href="/">DinkusKit / Store</a>
      <nav class="store-header__nav" aria-label="Store"><span class="store-header__status">{profile === "proof" ? "Demo store" : "Store"}</span><GuestCartNav /></nav>
    </header>
    <main>{sandboxCheckout
      ? <section class="guest-checkout-return" data-sandbox-checkout-return>
          <h1>Order confirmation</h1>
          {receipt?.status === "paid"
            ? <p role="status" data-sandbox-receipt="paid">Payment received (test){receiptTotal ? `: ${receiptTotal}` : ""}. Your order is confirmed. {SANDBOX_SESSION_NOTICE}</p>
            : receipt?.status === "rate-limited"
              ? <p role="status" data-sandbox-receipt="rate-limited">{SANDBOX_RATE_LIMITED_MESSAGE}</p>
            : receipt?.status === "client-ip-refused"
              ? <p role="status" data-sandbox-receipt="client-ip-refused">{SANDBOX_CLIENT_IP_MESSAGE}</p>
            : receipt?.status === "expired"
              ? <p role="status" data-sandbox-receipt="expired">This test checkout expired before payment. Nothing was charged; return to the cart to try again.</p>
            : receipt?.status === "pending"
              ? <p role="status" data-sandbox-receipt="pending">Payment is still processing (test). Refresh this page in a moment. {SANDBOX_SESSION_NOTICE}</p>
              : <p role="status" data-sandbox-receipt="unknown">If you completed payment, it was received in test mode. This playground session may have ended; start a new playground to try again.</p>}
          <a class="guest-checkout-continue" href="/">Continue shopping</a>
        </section>
      : <GuestCheckoutReturn contactHref={contactHref} />}</main>
  </body>
</html>
