{
  "name": "@dinkuskit/template-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Store starter and integration proof for EmDash, Commerce, and Inventory",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@11.9.0",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "dinkuskit": {
    "sourcePins": {
      "commerce": {
        "repository": "https://github.com/dinkuskit/commerce.git",
        "commit": "c42597bddd35d949f4e69f8ca97cc26206200da0"
      }
    },
    "playgroundPlugins": {
      "payments": {
        "repository": "https://github.com/dinkuskit/payments.git",
        "tag": "v0.4.0",
        "commit": "82c19d0d347d2c78a8e44dd2a3b2f00e530beb84"
      },
      "ship": {
        "repository": "https://github.com/dinkuskit/ship.git",
        "tag": "v0.3.0",
        "commit": "dab45d0df69a5f39158b603ff2b8236c6af6fe54"
      }
    }
  },
  "scripts": {
    "prepare:sources": "node scripts/prepare-source-deps.mjs && node scripts/prepare-playground-plugins.mjs",
    "predev": "pnpm prepare:sources",
    "dev": "astro dev",
    "dev:fresh": "bash scripts/dev-fresh.sh",
    "prebuild": "pnpm prepare:sources",
    "build": "node scripts/build-demo.mjs",
    "build:registry": "pnpm prepare:sources && node scripts/build-registry.mjs",
    "pretypecheck": "pnpm prepare:sources",
    "typecheck": "astro check",
    "pretest": "pnpm prepare:sources",
    "test": "vitest run",
    "pretest:e2e": "pnpm prepare:sources",
    "test:e2e": "playwright test",
    "audit:features": "node scripts/check-features.mjs",
    "verify:playground-config": "node scripts/verify-playground-config.mjs",
    "verify:playground-authority": "pnpm prepare:sources && node scripts/verify-playground-checkout-authority.mjs",
    "verify:playground-http": "pnpm prepare:sources && node scripts/verify-playground-checkout-http.mjs",
    "verify:playground-account-http": "pnpm prepare:sources && node scripts/verify-playground-account-http.mjs",
    "seed:bundle": "node scripts/build-seed-bundle.mjs",
    "seed:demo": "node --import ./scripts/cloudflare-workers-hook.mjs .artifacts/seed/seed-synthetic-demo.mjs",
    "search:upgrade": "node scripts/upgrade-storefront-search.ts",
    "verify:quick": "bin/verify-web quick",
    "verify:full": "bin/verify-web full",
    "verify": "bin/verify-web full",
    "verify:access-routes": "pnpm prepare:sources && node scripts/verify-access-routes.mjs --check",
    "verify:checkout-package": "node scripts/verify-checkout-package.mjs",
    "verify:paired-checkout": "node scripts/verify-paired-checkout.mjs",
    "verify:registry-checkout": "node scripts/verify-registry-checkout.mjs",
    "verify:merchant-checkout": "node scripts/verify-merchant-checkout.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.7",
    "@astrojs/node": "11.0.2",
    "@astrojs/react": "6.0.1",
    "@dinkuskit/inventory": "github:dinkuskit/inventory#5889c7d59398376da51ac400d5c1f1214aba2c6b",
    "@emdash-cms/cloudflare": "1.2.0",
    "astro": "7.1.3",
    "emdash": "1.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@emdash-cms/auth": "1.2.0",
    "@emdash-cms/blocks": "1.2.0",
    "@emdash-cms/plugin-cli": "0.13.3",
    "@emdash-cms/sandbox-workerd": "0.9.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "better-sqlite3": "12.11.1",
    "csv-parse": "6.1.0",
    "entities": "6.0.1",
    "kysely": "0.29.5",
    "sax": "1.6.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.145.0"
  }
}
