{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "DinkusKit store starter",
    "description": "Neutral Commerce shop starter with EmDash composition",
    "author": "DinkusKit contributors"
  },
  "collections": [
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "supports": [
        "drafts",
        "revisions",
        "search"
      ],
      "urlPattern": "/{slug}",
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        },
        {
          "slug": "layout",
          "label": "Layout",
          "type": "blocks",
          "validation": {
            "allowedTypes": [
              "home_opener",
              "rich_text",
              "query_card"
            ],
            "maxItems": 50
          }
        }
      ]
    },
    {
      "slug": "products",
      "label": "Products",
      "labelSingular": "Product",
      "urlPattern": "/products/{slug}",
      "seo": true,
      "supports": [
        "drafts",
        "revisions",
        "search"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Product title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "categories",
          "label": "Categories",
          "type": "reference",
          "validation": {
            "relation": "product_categories",
            "relationSide": "child"
          }
        },
        {
          "slug": "commerce_item_id",
          "label": "Commerce product",
          "type": "string"
        },
        {
          "slug": "description",
          "label": "Short description",
          "type": "string",
          "searchable": true
        },
        {
          "slug": "summary",
          "label": "Summary (shown beside the price)",
          "type": "portableText",
          "searchable": true
        },
        {
          "slug": "details",
          "label": "Product details (sections below the price)",
          "type": "blocks",
          "validation": {
            "allowedTypes": [
              "collapsible_section",
              "spec_table",
              "rich_text"
            ],
            "maxItems": 30
          }
        },
        {
          "slug": "visual_label",
          "label": "Placeholder art (optional, used only when Commerce has no image)",
          "type": "string"
        }
      ]
    },
    {
      "slug": "categories",
      "label": "Product categories",
      "labelSingular": "Product category",
      "urlPattern": "/categories/{slug}",
      "seo": true,
      "supports": [
        "drafts",
        "revisions",
        "search"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Category title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "description",
          "label": "Description",
          "type": "string",
          "searchable": true
        },
        {
          "slug": "products",
          "label": "Products in this category",
          "type": "reference",
          "validation": {
            "relation": "product_categories",
            "relationSide": "parent"
          }
        }
      ]
    }
  ],
  "taxonomies": [
    {
      "name": "category",
      "label": "Post categories",
      "labelSingular": "Post category",
      "hierarchical": true,
      "collections": ["posts"]
    }
  ],
  "relations": [
    {
      "slug": "product_categories",
      "parentCollection": "categories",
      "childCollection": "products",
      "parentLabel": "Products",
      "childLabel": "Categories",
      "maxChildrenPerParent": null,
      "maxParentsPerChild": null
    }
  ],
  "menus": [
    {
      "name": "primary",
      "label": "Main navigation",
      "items": [
        { "type": "custom", "label": "Home", "url": "/" },
        {
          "type": "custom",
          "label": "Shop",
          "url": "/#commerce-catalog",
          "children": [
            { "type": "custom", "label": "All products", "url": "/#commerce-catalog" },
            { "type": "collection", "label": "Hats", "collection": "categories", "ref": "hats" },
            { "type": "collection", "label": "Hoodies", "collection": "categories", "ref": "hoodies" },
            { "type": "collection", "label": "Tees", "collection": "categories", "ref": "tees" }
          ]
        }
      ]
    },
    {
      "name": "store-primary",
      "label": "Store navigation",
      "items": [
        {
          "type": "collection",
          "label": "Hats",
          "collection": "categories",
          "ref": "hats"
        },
        {
          "type": "collection",
          "label": "Hoodies",
          "collection": "categories",
          "ref": "hoodies"
        },
        {
          "type": "collection",
          "label": "Tees",
          "collection": "categories",
          "ref": "tees"
        }
      ]
    },
    {
      "name": "footer_shop",
      "label": "Footer shop links",
      "items": [
        { "type": "custom", "label": "All products", "url": "/#commerce-catalog" },
        { "type": "collection", "label": "Hats", "collection": "categories", "ref": "hats" },
        { "type": "collection", "label": "Hoodies", "collection": "categories", "ref": "hoodies" },
        { "type": "collection", "label": "Tees", "collection": "categories", "ref": "tees" }
      ]
    },
    {
      "name": "footer_policies",
      "label": "Footer policies",
      "items": [
        { "type": "custom", "label": "Shipping", "url": "/shipping" },
        { "type": "custom", "label": "Returns", "url": "/returns" }
      ]
    },
    {
      "name": "footer_account",
      "label": "Footer account links",
      "items": [
        { "type": "custom", "label": "Account", "url": "/account" },
        { "type": "custom", "label": "Shopping bag", "url": "/cart" }
      ]
    }
  ],
  "redirects": [
    { "source": "/product/[slug]", "destination": "/products/[slug]", "type": 301, "groupName": "Moving from WooCommerce" },
    { "source": "/product-category/[slug]", "destination": "/categories/[slug]", "type": 301, "groupName": "Moving from WooCommerce" }
  ],
  "widgetAreas": [
    {
      "name": "footer",
      "label": "Footer",
      "widgets": [
        {
          "type": "content",
          "title": "Store note",
          "content": [
            {
              "_type": "block",
              "_key": "footer-note-block",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "footer-note-span",
                  "text": "Editorial pages, menus, sections, and widgets are managed in EmDash.",
                  "marks": []
                }
              ]
            }
          ]
        },
        {
          "type": "menu",
          "title": "Your account",
          "menuName": "footer_account"
        },
        {
          "type": "component",
          "title": "Search catalog",
          "componentId": "core:search",
          "props": {
            "placeholder": "Search products..."
          }
        }
      ]
    }
  ],
  "sections": [
    {
      "slug": "home-opener",
      "title": "Home opener",
      "description": "Copied page opener: one hero, then a short fact rail. Later edits to this library section do not change copies already inserted.",
      "keywords": [
        "home",
        "opener",
        "homepage",
        "hero",
        "welcome",
        "introduction",
        "facts"
      ],
      "source": "theme",
      "content": [
        {
          "_type": "dinkus.page-hero",
          "_key": "home-opener-hero",
          "eyebrow": "Start here",
          "headline": "Welcome to the shop",
          "deck": "Browse products published in Commerce.",
          "primary_label": "Browse the shop",
          "primary_href": "#commerce-catalog",
          "secondary_label": "View products",
          "secondary_href": "#commerce-catalog"
        },
        {
          "_type": "dinkus.fact-rail",
          "_key": "home-opener-facts",
          "ariaLabel": "Shop opener facts",
          "facts": [
            {
              "_key": "home-opener-fact-hours",
              "label": "Hours",
              "value": "Posted by the shop"
            },
            {
              "_key": "home-opener-fact-visit",
              "label": "Visit",
              "value": "Come in or order ahead"
            },
            {
              "_key": "home-opener-fact-notes",
              "label": "Notes",
              "value": "Rewrite this rail"
            }
          ]
        }
      ]
    },
    {
      "slug": "policy-support-note",
      "title": "Policy and care note",
      "description": "Reusable Portable Text support note rendered alongside Shipping and Returns policies.",
      "keywords": [
        "policy",
        "shipping",
        "returns",
        "support",
        "provenance"
      ],
      "source": "theme",
      "content": [
        {
          "_type": "block",
          "_key": "policy-support-heading",
          "style": "h3",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "policy-support-heading-span",
              "text": "Policy provenance",
              "marks": []
            }
          ]
        },
        {
          "_type": "block",
          "_key": "policy-support-authority",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "policy-support-authority-span",
              "text": "Authoritative shipping charges, handling windows, and return eligibility come directly from the connected Commerce store.",
              "marks": []
            }
          ]
        }
      ]
    }
  ],
  "content": {
    "pages": [
      {
        "id": "home",
        "slug": "home",
        "status": "published",
        "data": {
          "title": "DinkusKit Store Starter",
          "content": [
            {
              "_type": "dinkus.page-hero",
              "_key": "store-hero",
              "eyebrow": "A classic merch catalog",
              "headline": "Everyday essentials, clearly presented",
              "deck": "Browse products published in Commerce. Prices and availability come from there.",
              "primaryLabel": "Shop the collection",
              "primaryHref": "#commerce-catalog",
              "secondaryLabel": "View products",
              "secondaryHref": "#commerce-catalog"
            },
            {
              "_type": "dinkus.fact-rail",
              "_key": "store-facts",
              "ariaLabel": "Shop opener facts",
              "facts": [
                {
                  "_key": "fact-content",
                  "label": "Composition",
                  "value": "EmDash + Blocks"
                },
                {
                  "_key": "fact-catalog",
                  "label": "Catalog",
                  "value": "Dinkus Commerce"
                },
                {
                  "_key": "fact-checkout",
                  "label": "Checkout",
                  "value": "Dinkus Payments"
                }
              ]
            }
          ],
          "layout": [
            {
              "_type": "home_opener",
              "_version": 1,
              "_key": "store-home-opener",
              "eyebrow": "A classic merch catalog",
              "headline": "Everyday essentials, clearly presented",
              "deck": "Browse products published in Commerce. Prices and availability come from there.",
              "primary_label": "Shop the collection",
              "primary_href": "#commerce-catalog",
              "secondary_label": "View products",
              "secondary_href": "#commerce-catalog",
              "facts": [
                {
                  "label": "Composition",
                  "value": "EmDash + Blocks"
                },
                {
                  "label": "Catalog",
                  "value": "Dinkus Commerce"
                },
                {
                  "label": "Checkout",
                  "value": "Dinkus Payments"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "shipping",
        "slug": "shipping",
        "status": "published",
        "data": {
          "title": "Shipping",
          "content": [
            {
              "_type": "block",
              "_key": "shipping-cutoff-heading",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "_key": "shipping-cutoff-heading-span",
                  "text": "Order processing & cut-off times"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "shipping-cutoff-body",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "shipping-cutoff-body-span",
                  "text": "Authoritative shipping charges, destination regions, handling windows, and transit estimates come from the connected Commerce shipping policy summary above. Edit this page in EmDash to publish your store's dispatch schedule or fulfillment guidance."
                }
              ]
            },
            {
              "_type": "block",
              "_key": "shipping-tracking-heading",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "_key": "shipping-tracking-heading-span",
                  "text": "Carrier tracking & delivery"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "shipping-tracking-body",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "shipping-tracking-body-span",
                  "text": "Use this section in EmDash to describe how your store shares shipment updates, carrier notifications, or delivery instructions once an order is fulfilled."
                }
              ]
            }
          ]
        }
      },
      {
        "id": "returns",
        "slug": "returns",
        "status": "published",
        "data": {
          "title": "Returns",
          "content": [
            {
              "_type": "block",
              "_key": "returns-eligibility-heading",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "_key": "returns-eligibility-heading-span",
                  "text": "Item condition & eligibility"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "returns-eligibility-body",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "returns-eligibility-body-span",
                  "text": "Authoritative return eligibility, return window length, return method, and fee terms come from the connected Commerce return policy summary above. Edit this page in EmDash to publish your store's item-condition requirements or category notes."
                }
              ]
            },
            {
              "_type": "block",
              "_key": "returns-initiate-heading",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "_key": "returns-initiate-heading-span",
                  "text": "How to initiate a return"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "returns-initiate-body",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "returns-initiate-body-span",
                  "text": "Use this section in EmDash to outline how shoppers should request a return and where to direct questions about an existing order."
                }
              ]
            }
          ]
        }
      }
    ],
    "categories": [
      {
        "id": "tees",
        "slug": "tees",
        "status": "published",
        "data": {
          "title": "Tees",
          "description": "Everyday layers for the rotation."
