  },
  "blockTypes": [
    {
      "slug": "home_opener",
      "label": "Home opener",
      "category": "Layout",
      "currentVersion": 1,
      "versions": [
        {
          "version": 1,
          "fields": [
            {
              "slug": "eyebrow",
              "label": "Eyebrow",
              "type": "string"
            },
            {
              "slug": "headline",
              "label": "Headline",
              "type": "string",
              "required": true
            },
            {
              "slug": "deck",
              "label": "Introduction",
              "type": "text"
            },
            {
              "slug": "primary_label",
              "label": "Primary link label",
              "type": "string"
            },
            {
              "slug": "primary_href",
              "label": "Primary link URL",
              "type": "string"
            },
            {
              "slug": "secondary_label",
              "label": "Secondary link label",
              "type": "string"
            },
            {
              "slug": "secondary_href",
              "label": "Secondary link URL",
              "type": "string"
            },
            {
              "slug": "facts",
              "label": "Facts",
              "type": "repeater",
              "validation": {
                "subFields": [
                  {
                    "slug": "label",
                    "label": "Label",
                    "type": "string",
                    "required": true
                  },
                  {
                    "slug": "value",
                    "label": "Value",
                    "type": "string",
                    "required": true
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "slug": "rich_text",
      "label": "Rich text",
      "category": "Content",
      "currentVersion": 1,
      "versions": [
        {
          "version": 1,
          "fields": [
            {
              "slug": "content",
              "label": "Content",
              "type": "portableText"
            }
          ]
        }
      ]
    },
    {
      "slug": "query_card",
      "label": "Query card",
      "category": "Content",
      "currentVersion": 1,
      "versions": [
        {
          "version": 1,
          "fields": [
            {
              "slug": "source",
              "label": "Source collection slug",
              "type": "string",
              "required": true
            },
            {
              "slug": "limit",
              "label": "Maximum published records",
              "type": "integer",
              "required": true,
              "validation": {
                "min": 1,
                "max": 24
              }
            }
          ]
        }
      ]
    },
    {
      "slug": "collapsible_section",
      "label": "Collapsible section",
      "category": "Content",
      "currentVersion": 1,
      "versions": [
        {
          "version": 1,
          "fields": [
            {
              "slug": "heading",
              "label": "Heading",
              "type": "string",
              "required": true
            },
            {
              "slug": "content",
              "label": "Content",
              "type": "portableText"
            },
            {
              "slug": "open_by_default",
              "label": "Open by default",
              "type": "boolean"
            }
          ]
        }
      ]
    },
    {
      "slug": "spec_table",
      "label": "Specification table",
      "category": "Content",
      "currentVersion": 1,
      "versions": [
        {
          "version": 1,
          "fields": [
            {
              "slug": "heading",
              "label": "Heading",
              "type": "string"
            },
            {
              "slug": "rows",
              "label": "Rows",
              "type": "repeater",
              "validation": {
                "subFields": [
                  {
                    "slug": "label",
                    "label": "Label",
                    "type": "string",
                    "required": true
                  },
                  {
                    "slug": "value",
                    "label": "Value",
                    "type": "string",
                    "required": true
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
