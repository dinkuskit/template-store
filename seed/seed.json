{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "DinkusKit store starter",
    "description": "Neutral classic merchandise catalog with managed and unmanaged availability proof",
    "author": "DinkusKit contributors"
  },
  "collections": [
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText"
        }
      ]
    },
    {
      "slug": "merchandise",
      "label": "Merchandise",
      "labelSingular": "Merch item",
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Display title",
          "type": "string",
          "required": true
        },
        {
          "slug": "category",
          "label": "Collection name",
          "type": "string",
          "required": true
        },
        {
          "slug": "description",
          "label": "Short description",
          "type": "string"
        },
        {
          "slug": "visual_label",
          "label": "Illustration style (TEE, HOODIE, CAP, or BEANIE)",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "content": {
    "pages": [
      {
        "id": "home",
        "slug": "home",
        "status": "published",
        "data": {
          "title": "DinkusKit Store Starter",
          "content": [
            {
              "_type": "dinkus.page-hero",
              "_key": "store-hero",
              "eyebrow": "A classic merch catalog",
              "headline": "Everyday essentials, clearly presented",
              "deck": "Explore tees, hoodies, and hats. Two connected styles show real availability; the rest are previews, not products for sale.",
              "primaryLabel": "Shop the collection",
              "primaryHref": "#catalog-title",
              "secondaryLabel": "See availability proof",
              "secondaryHref": "#managed-product"
            },
            {
              "_type": "dinkus.fact-rail",
              "_key": "store-facts",
              "ariaLabel": "Storefront proof facts",
              "facts": [
                {
                  "_key": "fact-content",
                  "label": "Composition",
                  "value": "EmDash + Blocks"
                },
                {
                  "_key": "fact-catalog",
                  "label": "Catalog",
                  "value": "Dinkus Commerce"
                },
                {
                  "_key": "fact-stock",
                  "label": "Stock truth",
                  "value": "Inventory + manual"
                }
              ]
            }
          ]
        }
      }
    ],
    "merchandise": [
      {
        "id": "everyday-tee",
        "slug": "everyday-tee",
        "status": "published",
        "data": {
          "title": "Everyday Tee",
          "category": "Tees",
          "description": "A clean, versatile tee for the everyday rotation.",
          "visual_label": "TEE"
        }
      },
      {
        "id": "boxy-tee-preview",
        "slug": "boxy-tee-preview",
        "status": "published",
        "data": {
          "title": "Boxy Tee",
          "category": "Tees",
          "description": "An easy silhouette with a relaxed feel.",
          "visual_label": "TEE"
        }
      },
      {
        "id": "pullover-hoodie-preview",
        "slug": "pullover-hoodie-preview",
        "status": "published",
        "data": {
          "title": "Pullover Hoodie",
          "category": "Hoodies",
          "description": "A comfortable layer for cooler days.",
          "visual_label": "HOODIE"
        }
      },
      {
        "id": "canvas-cap",
        "slug": "canvas-cap",
        "status": "published",
        "data": {
          "title": "Canvas Cap",
          "category": "Hats",
          "description": "A simple finishing touch for casual days.",
          "visual_label": "CAP"
        }
      },
      {
        "id": "ribbed-beanie-preview",
        "slug": "ribbed-beanie-preview",
        "status": "published",
        "data": {
          "title": "Ribbed Beanie",
          "category": "Hats",
          "description": "A soft, close-fitting cold-weather staple.",
          "visual_label": "BEANIE"
